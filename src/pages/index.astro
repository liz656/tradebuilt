---
import Layout from '../components/Layout.astro';
import Nav from '../components/Nav.astro';
---

<Layout>
  <Nav />

  <!-- ── HERO ── -->
<section class="hero">
  <div class="hero-left">
    <div class="eyebrow">Georgia Construction Talent Initiative</div>
    <h1>Amplifying<br>Real Stories.<br><em>Attracting</em><br><em>Genuine Talent.</em></h1>
    <p class="hero-body">
      This is a field-driven space where we bring together
      <strong>educators, parents, students, employers, trade associations, and training providers</strong>
      through collaborative research — highlighting what is actually working in our industry and the
      strategies that are attracting the next generation in the state of Georgia.
    </p>
    <div class="cta-row">
      <a href="/study" class="btn-hero">Explore the Study</a>
      <a href="/careers" class="btn-hero">Explore Construction Careers</a>
      <a href="/about" class="btn-hero">Explore the Why</a>
    </div>
  </div>
  <div class="hero-right">
    <div class="hero-fade"></div>
    <img src="/Main_SC2023.jpg" alt="Skills Challenge 2023" />
  </div>
</section>

  <!-- ── REALITY ── -->
  <section class="reality">
    <div class="section-label">The reality</div>
    <h2>The Work Is Happening. It’s Time to Scale It.</h2>
    <p class="reality-intro">
      Strong programs are already working — in classrooms, on jobsites, inside associations and
      training programs. The challenge isn't building from zero.
      <strong>It's making what works visible and scalable statewide.</strong>
    </p>
    <div class="solution-grid">
      <div class="solution-item">
        <h4>Identify what's working</h4>
        <p>Field-informed research across educators, contractors, associations, and training providers</p>
      </div>
      <div class="solution-item">
        <h4>Elevate the real story</h4>
        <p>Content and messaging rooted in jobsite reality, not recruitment spin</p>
      </div>
      <div class="solution-item">
        <h4>Build lasting alignment</h4>
        <p>Connecting the industry to initiatives in the state that produce results</p>
      </div>
      <div class="solution-item">
        <h4>Scale statewide</h4>
        <p>Make high-performing approaches accessible across Georgia</p>
      </div>
    </div>
  </section>

  <!-- ── PILLARS ── -->
  <section class="pillars">
    <div class="section-label">The initiative</div>
    <h2>Three Connected Parts.<br>One Workforce Message.</h2>
    <p class="pillars-sub">
      This isn't just a study or a website. This is an infrastructure that has been built by you
      and I will amplify the incredible work that is going on in our schools and on our jobsites.
    </p>
    <div class="pillar-grid">
      <div class="pillar">
        <div class="pillar-num">01 — The Study</div>
        <h3>Georgia Construction Talent Pipeline Study</h3>
        <p>Field-informed research capturing what's working and where opportunity exists across educators, contractors, associations, and training providers statewide.</p>
        <a class="pillar-link" href="/study">Participate →</a>
      </div>
      <div class="pillar">
        <div class="pillar-num">02 — The Platform</div>
        <h3>Construction Careers in Georgia</h3>
        <p>A centralized hub for students, educators, and industry with real pathways, jobsite stories, salary ranges, apprenticeship listings, and toolkits.</p>
        <a class="pillar-link" href="/careers">Explore Careers →</a>
      </div>
      <div class="pillar">
        <div class="pillar-num">03 — The Initiative</div>
        <h3>Ongoing Workforce Alignment</h3>
        <p>Content, partnerships, and field-driven campaigns that continuously strengthen the connection between education, associations, and the construction industry.</p>
        <a class="pillar-link" href="/platform">Learn More →</a>
      </div>
    </div>
  </section>

  <!-- ── AUDIENCES ── -->
  <section class="audiences">
    <div class="section-label">Who I work with</div>
    <h2>Built for the People<br>Who Build Georgia.</h2>
    <div class="aud-grid">
      <div class="aud-card">
        <h4>Training Providers</h4>
        <p>I promote apprenticeship programs and trade schools across Georgia driving students and parents directly to the programs that are producing the next generation of skilled professionals. Your program deserves visibility with the people actively looking for a path.</p>
      </div>
      <div class="aud-card">
        <h4>Trade Associations</h4>
        <p>I amplify your workforce initiatives, increase visibility with students and educators, and position your organization as a leader in Georgia's construction talent pipeline.</p>
      </div>
      <div class="aud-card">
        <h4>Educators</h4>
        <p>I connect you with real industry partners and provide classroom-ready resources — so your students see a clear, compelling path into the trades.</p>
      </div>
    </div>
  </section>
<!-- ── QUOTE ── -->
  <section class="quote-section">
    <div class="quote-inner">
      <div class="quote-headshot">
        <img src="/TBHeadshot_Prelim.png" alt="Liz Campbell" />
      </div>
      <div class="quote-content">
        <div class="quote-marks">"</div>
        <p class="quote-main">I've seen first hand what happens when contractors actively engage with their local school system. I believe what we have all created here in Georgia is something special. We set the standard for what construction workforce development should look like.</p>
        <p class="quote-attribution">Liz Campbell — Founder, TradeBuilt</p>
      </div>
    </div>
  </section>
  <!-- ── PARTNER ── -->
  <section class="partner">
    <div class="section-label">Become a partner</div>
    <h2>Be Part of<br>What's Being Built.</h2>
    <p class="partner-sub">
      I'm looking for founding partners who want to help shape workforce strategy and be recognized
      as leaders in building Georgia's next generation construction pipeline.
    </p>
    <ul class="partner-list">
      <li>Shape the direction of the statewide study</li>
      <li>Gain visibility with students and educators</li>
      <li>Early access to research insights and findings</li>
      <li>Featured presence on the careers platform</li>
      <li>Ongoing marketing and content strategy support</li>
      <li>Recognition as a workforce development leader</li>
    </ul>
  </section>

  <!-- ── FOOTER CTA ── -->
  <section class="footer-cta">
    <div class="fc-grid"></div>
    <h2>The Future of the<br>Workforce Isn't Built<br>by <em>Accident.</em></h2>
   <div class="fc-btns">
    </div>
    <div class="fc-mark">
      <img src="/TradeBuilt Logo_BuilderMark_NavyBckgdCreamLogo.png" alt="TradeBuilt" />
    </div>
  </section>

  <!-- ── FOOTER ── -->
  <footer class="site-footer">
    <div class="footer-logo">TradeBuilt <span>·</span> Est. 2026</div>
    <div class="footer-copy">Georgia Construction Talent Pipeline Initiative · © 2026</div>
  </footer>
</Layout>

<style>
/* ── HERO ── */
.hero {
  display: grid;
  grid-template-columns: 1fr 1fr;
  min-height: 580px;
  border-bottom: 0.5px solid var(--tb-border);
  background: var(--tb-bg-deep);
  overflow: hidden;
  position: relative;
}

.hero-left {
  padding: 72px 48px 64px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  position: relative;
  z-index: 2;
}

.hero-right {
  position: relative;
  overflow: hidden;
}

.hero-right img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center center;
  display: block;
}

.hero-fade {
  position: absolute;
  top: 0; left: 0;
  width: 60%;
  height: 100%;
  background: linear-gradient(to right, #0e1520 0%, rgba(14,21,32,0.6) 60%, transparent 100%);
  z-index: 1;
  pointer-events: none;
}

.eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  font-size: 14px;
  font-weight: 600;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--tb-text-dim);
  margin-bottom: 28px;
  border: 0.5px solid var(--tb-border);
  padding: 6px 14px;
  width: fit-content;
}

.hero h1 {
  font-family: 'Barlow Condensed', sans-serif;
  font-weight: 900;
  font-size: 68px;
  line-height: 0.93;
  letter-spacing: -0.01em;
  text-transform: uppercase;
  color: var(--tb-text-cream);
  margin-bottom: 28px;
}

.hero h1 em {
  font-style: normal;
  color: transparent;
  -webkit-text-stroke: 1.5px var(--tb-text-cream);
}

.hero-body {
  max-width: 480px;
  font-size: 15px;
  line-height: 1.8;
  color: var(--tb-text-dim);
  margin-bottom: 40px;
}

.hero-body strong { color: var(--tb-text-cream); font-weight: 500; }

.cta-row { display: flex; gap: 10px; flex-wrap: wrap; }

.btn-hero {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 15px;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  background: transparent;
  color: var(--tb-text-cream);
  border: 1px solid var(--tb-text-cream);
  padding: 12px 20px;
  cursor: pointer;
  text-decoration: none;
  display: inline-block;
  transition: background 0.2s, color 0.2s;
}

.btn-hero:hover {
  background: var(--tb-text-cream);
  color: var(--tb-bg-deep);
}

@media (max-width: 768px) {
  .hero {
    grid-template-columns: 1fr;
    min-height: auto;
  }

  .hero-right {
    height: 280px;
  }

  .hero-left {
    padding: 48px 24px 40px;
  }

  .hero h1 { font-size: 48px; }

  .cta-row { flex-direction: column; }
  .cta-row a { text-align: center; }
}
  /* ── REALITY ── */
  .reality {
    padding: 64px 40px;
    border-bottom: 0.5px solid var(--tb-border);
    background: var(--tb-bg-base);
  }

  .reality h2 {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 900;
    font-size: 64px;
    line-height: 1.05;
    text-transform: uppercase;
    color: var(--tb-text-cream);
    margin-bottom: 20px;
    max-width: 560px;
  }

  .reality-intro {
    font-size: 18px;
    line-height: 1.75;
    color: var(--tb-text-dim);
    margin-bottom: 32px;
    max-width: 620px;
  }

  .reality-intro strong { color: var(--tb-text-cream); font-weight: 500; }

  .solution-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border: 0.5px solid var(--tb-border);
  }

  .solution-item {
    padding: 20px 22px;
    border-bottom: 0.5px solid var(--tb-border);
    border-right: 0.5px solid var(--tb-border);
  }

  .solution-item:nth-child(2n) { border-right: none; }
  .solution-item:nth-last-child(-n+2) { border-bottom: none; }

  .solution-item h4 {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 20px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--tb-text-cream);
    margin-bottom: 4px;
  }

  .solution-item p { font-size: 18px; color: var(--tb-text-dim); line-height: 1.55; margin: 0; }

  /* ── PILLARS ── */
  .pillars {
    padding: 64px 40px;
    border-bottom: 0.5px solid var(--tb-border);
    background: var(--tb-bg-deep);
  }

  .pillars h2 {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 900;
    font-size: 64px;
    line-height: 1;
    text-transform: uppercase;
    color: var(--tb-text-cream);
    margin-bottom: 8px;
  }

  .pillars-sub {
    font-size: 18px;
    color: var(--tb-text-dim);
    margin-bottom: 40px;
    max-width: 540px;
    line-height: 1.75;
  }

  .pillar-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border: 0.5px solid var(--tb-border);
  }

  .pillar { padding: 32px 24px; border-right: 0.5px solid var(--tb-border); }
  .pillar:last-child { border-right: none; }

  .pillar-num {
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--tb-text-dark);
    margin-bottom: 24px;
    text-transform: uppercase;
  }

  .pillar-icon {
    width: 32px; height: 32px;
    border: 1px solid var(--tb-border-mid);
    display: flex; align-items: center; justify-content: center;
    margin-bottom: 18px;
    color: var(--tb-text-cream);
  }

  .pillar h3 {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 20px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--tb-text-cream);
    margin-bottom: 10px;
    line-height: 1.15;
  }

  .pillar p { font-size: 16px; line-height: 1.65; color: var(--tb-text-dim); margin-bottom: 20px; }

  .pillar-link {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--tb-text-cream);
    text-decoration: none;
    border-bottom: 1px solid var(--tb-border-mid);
    padding-bottom: 2px;
  }

  /* ── AUDIENCES ── */
  .audiences {
    padding: 64px 40px;
    border-bottom: 0.5px solid var(--tb-border);
    background: var(--tb-bg-base);
  }

  .audiences h2 {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 64px;
    font-weight: 900;
    text-transform: uppercase;
    color: var(--tb-text-cream);
    margin-bottom: 32px;
  }

  .aud-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }

  .aud-card {
    background: var(--tb-bg-deep);
    border: 0.5px solid var(--tb-border);
    padding: 24px 20px;
  }

  .aud-card h4 {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 20px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--tb-text-cream);
    margin-bottom: 12px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--tb-border-mid);
  }

  .aud-card p { font-size: 16px; line-height: 1.65; color: var(--tb-text-dim); }

/* ── QUOTE SECTION ── */
  .quote-section {
    padding: 80px 40px;
    border-bottom: 0.5px solid var(--tb-border);
    background: var(--tb-bg-base);
  }

  .quote-inner {
    display: flex;
    align-items: center;
    gap: 56px;
    max-width: 780px;
    margin: 0 auto;
  }

  .quote-headshot {
    flex-shrink: 0;
    width: 180px;
    height: 180px;
    border-radius: 50%;
    overflow: hidden;
    border: 3px solid var(--tb-border-mid);
    box-shadow: 0 0 0 6px var(--tb-bg-deep);
  }

  .quote-headshot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }

  .quote-content {
    flex: 1;
  }

  .quote-marks {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 80px;
    font-weight: 900;
    color: var(--tb-border-mid);
    line-height: 0.6;
    margin-bottom: 16px;
  }

  .quote-main {
    font-size: 16px;
    line-height: 1.8;
    color: var(--tb-text-cream);
    font-style: italic;
    margin-bottom: 20px;
  }

  .quote-attribution {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--tb-text-dim);
    padding-top: 16px;
    border-top: 0.5px solid var(--tb-border);
  }
  /* ── PARTNER ── */
  .partner {
    padding: 64px 40px;
    border-bottom: 0.5px solid var(--tb-border);
    background: var(--tb-bg-base);
  }

  .partner h2 {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 64px;
    font-weight: 900;
    text-transform: uppercase;
    color: var(--tb-text-cream);
    margin-bottom: 8px;
  }

  .partner-sub {
    font-size: 18px;
    color: var(--tb-text-dim);
    max-width: 460px;
    line-height: 1.7;
    margin-bottom: 32px;
  }

  .partner-list {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr 1fr;
    border: 0.5px solid var(--tb-border);
  }

  .partner-list li {
    padding: 13px 18px;
    font-size: 18px;
    color: var(--tb-text-muted);
    border-bottom: 0.5px solid var(--tb-border);
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .partner-list li::before {
    content: '';
    display: block;
    width: 4px; height: 4px;
    background: var(--tb-text-cream);
    flex-shrink: 0;
  }

  .partner-list li:nth-last-child(-n+2) { border-bottom: none; }

  /* ── FOOTER CTA ── */
  .footer-cta {
    padding: 72px 40px;
    text-align: center;
    position: relative;
    overflow: hidden;
    background: var(--tb-bg-deep);
  }

  .fc-grid {
    position: absolute; top: 0; left: 0; right: 0; bottom: 0;
    background-image:
      linear-gradient(rgba(232,227,213,0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(232,227,213,0.03) 1px, transparent 1px);
    background-size: 48px 48px;
    pointer-events: none;
  }

  .footer-cta h2 {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 80px;
    font-weight: 900;
    text-transform: uppercase;
    color: var(--tb-text-cream);
    line-height: 0.95;
    margin-bottom: 36px;
    position: relative;
  }

  .footer-cta h2 em {
    font-style: normal;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--tb-text-cream);
  }

  .fc-btns {
    display: flex;
    gap: 12px;
    justify-content: center;
    position: relative;
  }
.fc-mark {
    position: relative;
    margin-top: 40px;
  }

  .fc-mark img {
    width: 80px;
    height: 80px;
    object-fit: contain;
    opacity: 0.6;
  }
  /* ── SITE FOOTER ── */
  .site-footer {
    padding: 18px 40px;
    border-top: 0.5px solid var(--tb-border);
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: var(--tb-bg-deep);
  }

  .footer-logo {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 900;
    font-size: 15px;
    color: var(--tb-text-ghost);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .footer-logo span { color: var(--tb-text-dark); }

  .footer-copy { font-size: 14px; color: var(--tb-text-dark); letter-spacing: 0.06em; }
/* ── MOBILE RESPONSIVENESS ── */
  @media (max-width: 768px) {

    /* NAV */
    .tb-nav {
      flex-direction: column;
      gap: 16px;
      padding: 20px;
      text-align: center;
    }

    .tb-nav-links {
      flex-wrap: wrap;
      justify-content: center;
      gap: 16px;
    }

    /* HERO */
    .hero {
      padding: 48px 24px 48px;
    }

    .hero h1 {
      font-size: 48px;
    }

    .tagline {
      font-size: 15px;
    }

    .hero-body {
      font-size: 15px;
    }

    .cta-row {
      flex-direction: column;
    }

    .cta-row a {
      text-align: center;
    }

    /* REALITY */
    .reality {
      padding: 48px 24px;
    }

    .reality h2 {
      font-size: 30px;
    }

    .solution-grid {
      grid-template-columns: 1fr;
    }

    .solution-item {
      border-right: none !important;
    }

    .solution-item:nth-last-child(-n+2) {
      border-bottom: 0.5px solid var(--tb-border);
    }

    .solution-item:last-child {
      border-bottom: none;
    }

    /* PILLARS */
    .pillars {
      padding: 48px 24px;
    }

    .pillars h2 {
      font-size: 34px;
    }

    .pillar-grid {
      grid-template-columns: 1fr;
    }

    .pillar {
      border-right: none;
      border-bottom: 0.5px solid var(--tb-border);
    }

    .pillar:last-child {
      border-bottom: none;
    }

    /* AUDIENCES */
    .audiences {
      padding: 48px 24px;
    }

    .audiences h2 {
      font-size: 30px;
    }

    .aud-grid {
      grid-template-columns: 1fr;
    }

    /* STATS */
    .stats-grid {
      grid-template-columns: 1fr 1fr;
    }

    .stat {
      min-height: 120px;
      padding: 24px 20px;
    }

    .stat-num {
      font-size: 32px;
    }

    /* QUOTE SECTION */
    .quote-section {
      padding: 48px 24px;
    }

    .quote-inner {
      flex-direction: column;
      align-items: center;
      gap: 32px;
      text-align: center;
    }

    .quote-headshot {
      width: 140px;
      height: 140px;
    }

    .quote-marks {
      font-size: 60px;
    }

    .quote-main {
      font-size: 15px;
    }

    /* PARTNER */
    .partner {
      padding: 48px 24px;
    }

    .partner h2 {
      font-size: 34px;
    }

    .partner-list {
      grid-template-columns: 1fr;
    }

    .partner-list li:nth-last-child(-n+2) {
      border-bottom: 0.5px solid var(--tb-border);
    }

    .partner-list li:last-child {
      border-bottom: none;
    }

    /* FOOTER CTA */
    .footer-cta {
      padding: 48px 24px;
    }

    .footer-cta h2 {
      font-size: 38px;
    }

    .fc-btns {
      flex-direction: column;
      align-items: center;
    }

    .fc-btns a {
      width: 100%;
      text-align: center;
    }

    /* SITE FOOTER */
    .site-footer {
      flex-direction: column;
      gap: 8px;
      text-align: center;
      padding: 24px;
    }

  }

  /* ── TABLET ── */
  @media (max-width: 1024px) and (min-width: 769px) {

    .hero h1 {
      font-size: 58px;
    }

    .pillar-grid {
      grid-template-columns: 1fr 1fr;
    }

    .pillar:nth-child(2) {
      border-right: none;
    }

    .pillar:nth-child(3) {
      border-right: none;
      border-top: 0.5px solid var(--tb-border);
      grid-column: span 2;
    }

    .aud-grid {
      grid-template-columns: 1fr 1fr;
    }

    .stats-grid {
