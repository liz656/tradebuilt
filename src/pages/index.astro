---
import { Image } from 'astro:assets';
import Layout from '../components/Layout.astro';
import Nav from '../components/Nav.astro';
import Partners from '../components/Partners.astro';
import heroImage from '../assets/Main_SC2023.jpg';
import headshot from '../assets/Headshot_Final.jpg';
---

<Layout>
  <Nav />

  <!-- ── HERO ── -->
<section class="hero">
  <div class="hero-left">
    <div class="eyebrow">Workforce Development • Industry Strategy • Field-Driven Storytelling</div>
    <h1>Amplifying<br>Real Stories.<br><em>Attracting</em><br><em>Genuine Talent.</em></h1>
    <p class="hero-body">
      TradeBuilt helps contractors and trade associations strengthen the systems that attract, develop, and retain their workforce — while continuing to connect Georgia students, families, and educators with real construction careers and training pathways.
    </p>
    <div class="cta-row">
      <a href="mailto:liz@tradebuiltusa.com" class="btn-hero">Work With TradeBuilt</a>
      <a href="/careers" class="btn-hero">Explore Georgia Careers</a>
    </div>
  </div>
  <div class="hero-right">
    <div class="hero-fade"></div>
    <Image
      src={heroImage}
      alt="Skills Challenge 2023"
      widths={[640, 1024, 1600, 2400]}
      sizes="(max-width: 900px) 100vw, 55vw"
      loading="eager"
      fetchpriority="high"
    />
  </div>
</section>

  <!-- ── STUDY CALLOUT ── -->
  <section class="study-callout">
    <p><strong>The Georgia Construction Talent Study is underway.</strong> Help identify what is actually working in Georgia's construction workforce. <a href="/study">Participate in the Study →</a></p>
  </section>

  <!-- ── REALITY ── -->
  <section class="reality">
    <div class="section-label">The reality</div>
    <h2>The Work Is Happening. It’s Time to Scale It.</h2>
    <p class="reality-intro">
      Strong workforce practices are already working inside contractors, associations, training programs, and classrooms. The challenge isn't starting from zero.
      <strong>It's identifying what produces results, strengthening the systems behind it, and making the good work easier to repeat.</strong>
    </p>
    <div class="solution-grid">
      <div class="solution-item">
        <h4>Identify What's Working</h4>
        <p>Field-informed research and workforce assessments that show where the real opportunities are.</p>
      </div>
      <div class="solution-item">
        <h4>Strengthen the System</h4>
        <p>Practical workforce development built around recruiting, onboarding, mentorship, advancement, and retention.</p>
      </div>
      <div class="solution-item">
        <h4>Tell the Real Story</h4>
        <p>Employer branding, digital campaigns, and content rooted in the work itself, not recruitment spin.</p>
      </div>
      <div class="solution-item">
        <h4>Build Stronger Alignment</h4>
        <p>Connecting contractors, associations, educators, and training partners around strategies that produce results.</p>
      </div>
    </div>
  </section>

  <!-- ── PILLARS ── -->
  <section class="pillars">
    <div class="section-label">The initiative</div>
    <h2>Three Connected Parts.<br>One Workforce Message.</h2>
    <p class="pillars-sub">
      The industry doesn't need another awareness campaign. It needs alignment between the people already building the next generation workforce.
    </p>
    <div class="pillar-grid">
      <div class="pillar">
        <div class="pillar-num">01 — The Study</div>
        <h3>Georgia Construction Talent Study</h3>
        <p>Field-informed research capturing what's working and where opportunity exists across educators, contractors, associations, and training providers statewide.</p>
        <a class="pillar-link" href="/study">Participate →</a>
      </div>
      <div class="pillar">
        <div class="pillar-num">02 — The Platform</div>
        <h3>Construction Careers in Georgia</h3>
        <p>A centralized hub for students, educators, and industry with real pathways, jobsite stories, salary ranges, apprenticeship listings, and toolkits.</p>
        <a class="pillar-link" href="/careers">Explore Careers →</a>
      </div>
      <div class="pillar">
        <div class="pillar-num">03 — The Work</div>
        <h3>Workforce Development • Industry Strategy • Field-Driven Storytelling</h3>
        <p>TradeBuilt helps contractors and trade associations strengthen workforce systems, shape strategy, and tell the real story of the work through consulting, research, employer branding, and field-driven campaigns.</p>
        <a class="pillar-link" href="mailto:liz@tradebuiltusa.com">Work With TradeBuilt →</a>
      </div>
    </div>
  </section>

  <!-- ── AUDIENCES ── -->
  <section class="audiences">
    <div class="section-label">Who I work with</div>
    <h2>For the People<br>Moving Industry Forward.</h2>
    <div class="aud-grid">
      <div class="aud-card">
        <h4>Contractors</h4>
        <p>TradeBuilt helps contractors strengthen the systems that attract, develop, and retain their workforce — from first-year systems and apprenticeship strategy to employer branding and digital campaigns.</p>
      </div>
      <div class="aud-card">
        <h4>Trade Associations</h4>
        <p>TradeBuilt helps associations turn workforce challenges into practical member value through strategy, research, industry engagement, workforce resources, and storytelling.</p>
      </div>
    </div>
    <p class="aud-ecosystem">TradeBuilt also works across educators, training providers, apprenticeship programs, students, and workforce partners to strengthen the connections between industry and the next generation of construction talent.</p>
  </section>
<!-- ── QUOTE ── -->
  <section class="quote-section">
    <div class="quote-inner">
      <div class="quote-headshot">
        <Image
          src={headshot}
          alt="Liz Manning"
          widths={[300, 600, 944]}
          sizes="(max-width: 700px) 60vw, 300px"
        />
      </div>
      <div class="quote-content">
        <div class="quote-marks">"</div>
        <p class="quote-main">There is good workforce work happening all over this industry. The opportunity is to understand why it works, tell the story well, and make it easier for others to build on.</p>
        <p class="quote-attribution">Liz Manning — Owner, TradeBuilt</p>
      </div>
    </div>
  </section>
  <!-- ── PARTNER ── -->
  <section class="partner">
    <div class="section-label">Work with TradeBuilt</div>
    <h2>Be Part of<br>What's Being Built.</h2>
    <p class="partner-sub">
      Whether the challenge is workforce development, industry strategy, apprenticeship, retention, or how your company tells its story, the first step is understanding where the system is actually breaking.
    </p>
    <div class="partner-ctas">
      <a href="mailto:liz@tradebuiltusa.com" class="btn-hero">Start a Conversation →</a>
      <a class="btn-orange" href="/study">Participate in the Georgia Construction Talent Study →</a>
    </div>
  </section>

  <Partners />

  <!-- ── FOOTER CTA ── -->
  <section class="footer-cta">
    <div class="fc-grid"></div>
    <h2>The Future of the<br>Workforce Isn't Built<br>by <em>Accident.</em></h2>
   <div class="fc-btns">
      <a href="mailto:liz@tradebuiltusa.com" class="btn-cream">Partner with TradeBuilt</a>
      <a href="/study" class="btn-cream">Participate in the Study</a>
    </div>
    <div class="fc-social">
      <a href="https://www.linkedin.com/company/tradebuiltga" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6z"/>
          <rect x="2" y="9" width="4" height="12"/>
          <circle cx="4" cy="4" r="2"/>
        </svg>
      </a>
      <a href="https://www.tiktok.com/@tradebuiltliz" target="_blank" rel="noopener noreferrer" aria-label="TikTok">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor">
          <path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V8.69a8.18 8.18 0 004.78 1.52V6.75a4.85 4.85 0 01-1.01-.06z"/>
        </svg>
      </a>
      <a href="https://www.instagram.com/tradebuiltga" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
          <path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z"/>
          <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
        </svg>
      </a>
    </div>
    <div class="fc-mark">
      <img src="/TradeBuilt Logo_BuilderMark_NavyBckgdCreamLogo.png" alt="TradeBuilt" />
    </div>
  </section>

  <!-- ── FOOTER ── -->
  <footer class="site-footer">
    <div class="footer-logo">TradeBuilt <span>·</span> Est. 2026</div>
    <div class="footer-copy">© 2026 TradeBuilt</div>
  </footer>
</Layout>

<style>
/* ── HERO ── */
.hero {
  display: grid;
  grid-template-columns: 1fr 1fr;
  min-height: 580px;
  border-bottom: 0.5px solid var(--tb-border);
  background: var(--tb-bg-deep);
  overflow: hidden;
  position: relative;
}

.hero-left {
  padding: 72px 48px 64px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  position: relative;
  z-index: 2;
}

.hero-right {
  position: relative;
  overflow: hidden;
}

.hero-right img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center center;
  display: block;
}

.hero-fade {
  position: absolute;
  top: 0; left: 0;
  width: 60%;
  height: 100%;
  background: linear-gradient(to right, #0e1520 0%, rgba(14,21,32,0.6) 60%, transparent 100%);
  z-index: 1;
  pointer-events: none;
}

.eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  font-size: 14px;
  font-weight: 600;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--tb-text-dim);
  margin-bottom: 28px;
  border: 0.5px solid var(--tb-border);
  padding: 6px 14px;
  width: fit-content;
}

.hero h1 {
  font-family: 'Barlow Condensed', sans-serif;
  font-weight: 900;
  font-size: 68px;
  line-height: 0.93;
  letter-spacing: -0.01em;
  text-transform: uppercase;
  color: var(--tb-text-cream);
  margin-bottom: 28px;
}

.hero h1 em {
  font-style: normal;
  color: transparent;
  -webkit-text-stroke: 1.5px var(--tb-text-cream);
}

.hero-body {
  max-width: 480px;
  font-size: 15px;
  line-height: 1.8;
  color: var(--tb-text-dim);
  margin-bottom: 40px;
}

.hero-body strong { color: var(--tb-text-cream); font-weight: 500; }

.cta-row { display: flex; gap: 10px; flex-wrap: wrap; }

.btn-hero {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 15px;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  background: transparent;
  color: var(--tb-text-cream);
  border: 1px solid var(--tb-text-cream);
  padding: 12px 20px;
  cursor: pointer;
  text-decoration: none;
  display: inline-block;
  transition: background 0.2s, color 0.2s;
}

.btn-hero:hover {
  background: var(--tb-text-cream);
  color: var(--tb-bg-deep);
}

.btn-orange {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 15px;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  background: transparent;
  color: #c17830;
  border: 1px solid #c17830;
  padding: 12px 20px;
  cursor: pointer;
  text-decoration: none;
  display: inline-block;
  transition: background 0.2s, color 0.2s;
}

.btn-orange:hover {
  background: #c17830;
  color: var(--tb-bg-deep);
}

@media (max-width: 768px) {
  .hero {
    grid-template-columns: 1fr;
    min-height: auto;
  }

  .hero-right {
    height: 280px;
  }

  .hero-left {
    padding: 48px 24px 40px;
  }

  .hero h1 { font-size: 48px; }

  .cta-row { flex-direction: column; }
  .cta-row a { text-align: center; }
}

/* ── STUDY CALLOUT ── */
.study-callout {
  padding: 16px 40px;
  border-bottom: 0.5px solid var(--tb-border);
  background: #c17830;
  text-align: center;
}

.study-callout p {
  font-size: 14px;
  color: var(--tb-text-cream);
  letter-spacing: 0.02em;
  margin: 0;
}

.study-callout strong {
  color: var(--tb-text-cream);
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  margin-right: 6px;
}

.study-callout a {
  color: var(--tb-text-cream);
  text-decoration: none;
  border-bottom: 1px solid var(--tb-text-cream);
  margin-left: 6px;
  font-weight: 700;
}

@media (max-width: 768px) {
  .study-callout {
    padding: 14px 24px;
  }

  .study-callout p {
    font-size: 13px;
  }
}

  /* ── REALITY ── */
  .reality {
    padding: 64px 40px;
    border-bottom: 0.5px solid var(--tb-border);
    background: var(--tb-bg-base);
  }

  .reality h2 {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 900;
    font-size: 64px;
    line-height: 1.05;
    text-transform: uppercase;
    color: var(--tb-text-cream);
    margin-bottom: 20px;
    max-width: 560px;
  }

  .reality-intro {
    font-size: 18px;
    line-height: 1.75;
    color: var(--tb-text-dim);
    margin-bottom: 32px;
    max-width: 620px;
  }

  .reality-intro strong { color: var(--tb-text-cream); font-weight: 500; }

  .solution-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border: 0.5px solid var(--tb-border);
  }

  .solution-item {
    padding: 20px 22px;
    border-bottom: 0.5px solid var(--tb-border);
    border-right: 0.5px solid var(--tb-border);
  }

  .solution-item:nth-child(2n) { border-right: none; }
  .solution-item:nth-last-child(-n+2) { border-bottom: none; }

  .solution-item h4 {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 20px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--tb-text-cream);
    margin-bottom: 4px;
  }

  .solution-item p { font-size: 18px; color: var(--tb-text-dim); line-height: 1.55; margin: 0; }

  /* ── PILLARS ── */
  .pillars {
    padding: 64px 40px;
    border-bottom: 0.5px solid var(--tb-border);
    background: var(--tb-bg-deep);
  }

  .pillars h2 {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 900;
    font-size: 64px;
    line-height: 1;
    text-transform: uppercase;
    color: var(--tb-text-cream);
    margin-bottom: 8px;
  }

  .pillars-sub {
    font-size: 18px;
    color: var(--tb-text-dim);
    margin-bottom: 40px;
    max-width: 540px;
    line-height: 1.75;
  }

  .pillar-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border: 0.5px solid var(--tb-border);
  }

  .pillar { padding: 32px 24px; border-right: 0.5px solid var(--tb-border); }
  .pillar:last-child { border-right: none; }

  .pillar-num {
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--tb-text-dark);
    margin-bottom: 24px;
    text-transform: uppercase;
  }

  .pillar-icon {
    width: 32px; height: 32px;
    border: 1px solid var(--tb-border-mid);
    display: flex; align-items: center; justify-content: center;
    margin-bottom: 18px;
    color: var(--tb-text-cream);
  }

  .pillar h3 {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 20px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--tb-text-cream);
    margin-bottom: 10px;
    line-height: 1.15;
  }

  .pillar p { font-size: 16px; line-height: 1.65; color: var(--tb-text-dim); margin-bottom: 20px; }

  .pillar-link {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--tb-text-cream);
    text-decoration: none;
    border-bottom: 1px solid var(--tb-border-mid);
    padding-bottom: 2px;
  }

  /* ── AUDIENCES ── */
  .audiences {
    padding: 64px 40px;
    border-bottom: 0.5px solid var(--tb-border);
    background: linear-gradient(180deg, rgba(14,21,32,0.9), rgba(14,21,32,0.82)), url('/photo-aerial-atlanta.webp') center / cover no-repeat;
  }

  .audiences h2 {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 64px;
    font-weight: 900;
    text-transform: uppercase;
    color: var(--tb-text-cream);
    margin-bottom: 32px;
  }

  .aud-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; }

  .aud-card {
    background: rgba(14, 21, 32, 0.55);
    border: 0.5px solid var(--tb-border-mid);
    padding: 24px 20px;
  }

  .aud-card h4 {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 20px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--tb-text-cream);
    margin-bottom: 12px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--tb-border-mid);
  }

  .aud-card p { font-size: 16px; line-height: 1.65; color: var(--tb-text-dim); }

  .aud-ecosystem {
    margin-top: 28px;
    width: 100%;
    padding: 22px 28px;
    text-align: center;
    font-size: 16px;
    font-weight: 700;
    line-height: 1.7;
    color: var(--tb-bg-deep);
    background: var(--tb-text-cream);
  }

/* ── QUOTE SECTION ── */
  .quote-section {
    padding: 80px 40px;
    border-bottom: 0.5px solid var(--tb-border);
    background: var(--tb-bg-base);
  }

  .quote-inner {
    display: flex;
    align-items: center;
    gap: 56px;
    max-width: 780px;
    margin: 0 auto;
  }

  .quote-headshot {
    flex-shrink: 0;
    width: 180px;
    height: 180px;
    border-radius: 50%;
    overflow: hidden;
    border: 3px solid var(--tb-border-mid);
    box-shadow: 0 0 0 6px var(--tb-bg-deep);
  }

  .quote-headshot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }

  .quote-content {
    flex: 1;
  }

  .quote-marks {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 80px;
    font-weight: 900;
    color: var(--tb-border-mid);
    line-height: 0.6;
    margin-bottom: 16px;
  }

  .quote-main {
    font-size: 16px;
    line-height: 1.8;
    color: var(--tb-text-cream);
    font-style: italic;
    margin-bottom: 20px;
  }

  .quote-attribution {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--tb-text-dim);
    padding-top: 16px;
    border-top: 0.5px solid var(--tb-border);
  }
  /* ── PARTNER ── */
  .partner {
    padding: 64px 40px;
    border-bottom: 0.5px solid var(--tb-border);
    background: var(--tb-bg-base);
  }

  .partner h2 {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 64px;
    font-weight: 900;
    text-transform: uppercase;
    color: var(--tb-text-cream);
    margin-bottom: 8px;
  }

  .partner-sub {
    font-size: 18px;
    color: var(--tb-text-dim);
    max-width: 460px;
    line-height: 1.7;
    margin-bottom: 32px;
  }

  .partner-list {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr 1fr;
    border: 0.5px solid var(--tb-border);
  }

  .partner-list li {
    padding: 13px 18px;
    font-size: 18px;
    color: var(--tb-text-muted);
    border-bottom: 0.5px solid var(--tb-border);
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .partner-list li::before {
    content: '';
    display: block;
    width: 4px; height: 4px;
    background: var(--tb-text-cream);
    flex-shrink: 0;
  }

  .partner-list li:nth-last-child(-n+2) { border-bottom: none; }

  .partner-ctas {
    display: flex;
    align-items: center;
    gap: 28px;
    flex-wrap: wrap;
    margin-top: 8px;
  }

  /* ── FOOTER CTA ── */
  .footer-cta {
    padding: 72px 40px;
    text-align: center;
    position: relative;
    overflow: hidden;
    background: var(--tb-bg-deep);
  }

  .fc-grid {
    position: absolute; top: 0; left: 0; right: 0; bottom: 0;
    background-image:
      linear-gradient(rgba(232,227,213,0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(232,227,213,0.03) 1px, transparent 1px);
    background-size: 48px 48px;
    pointer-events: none;
  }

  .footer-cta h2 {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 80px;
    font-weight: 900;
    text-transform: uppercase;
    color: var(--tb-text-cream);
    line-height: 0.95;
    margin-bottom: 36px;
    position: relative;
  }

  .footer-cta h2 em {
    font-style: normal;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--tb-text-cream);
  }

  .fc-btns {
    display: flex;
    gap: 12px;
    justify-content: center;
    position: relative;
  }
.fc-mark {
    position: relative;
    margin-top: 40px;
  }

  .fc-mark img {
    width: 80px;
    height: 80px;
    object-fit: contain;
    opacity: 0.6;
  }
