---
import { Image } from 'astro:assets';
import Layout from '../components/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Partners from '../components/Partners.astro';
import heroImage from '../assets/Main_SC2023.jpg';
import headshot from '../assets/Headshot_Final.jpg';
// Our Work card photos — real TradeBuilt photography already on the site (see docs/visual-assets.md)
import imgResearch from '../assets/FieldConversation_Expo.jpg';
import imgCareers from '../assets/derived/SC2023_competitors_3x2.jpg';
import imgEngagement from '../assets/SkillsChallenge2025_Speaking.jpg';
const workImages = {
  'Research & Insights': { src: imgResearch, alt: 'A speaker with a microphone talks with a small group of educators and industry members at an outdoor career expo', tone: 'full', focus: 'center 30%' },
  'Career Awareness': { src: imgCareers, alt: 'Competitors framing walls at the Skills Challenge 2023', tone: 'full' },
  'Industry Engagement': { src: imgEngagement, alt: 'Liz Manning speaking at Skills Challenge 2025', tone: 'full' },
};
import { MISSION, PRINCIPLES, WORK_AREAS, STUDY, AMERICAN_TRADES_PUBLISHED } from '../data/site.js';
---

<Layout title="TradeBuilt | Built by the Field. Backed by Experience." description="Field perspectives, research, and career resources connecting the construction industry with its future workforce.">
  <Nav />

  <!-- ── HERO ── -->
<section class="hero">
  <div class="hero-left">
    <div class="eyebrow">Research • Career Awareness • Industry Engagement</div>
    <h1>Built by<br>the Field.<br><em>Backed by</em><br><em>Experience.</em></h1>
    <p class="hero-body">
      TradeBuilt brings field perspectives, construction career resources, and industry conversations together to help shape the future workforce.
    </p>
    <div class="cta-row">
      <a href="/careers#trades" class="btn-hero btn-hero--solid">Find Your Trade</a>
      <a href="/find-training" class="btn-hero">Find Training</a>
      <a href="/our-work" class="btn-hero">Explore Our Work</a>
    </div>
  </div>
  <div class="hero-right">
    <div class="hero-fade"></div>
    <Image
      src={heroImage}
      alt="Skills Challenge 2023"
      widths={[640, 1024, 1600, 2400]}
      sizes="(max-width: 900px) 100vw, 55vw"
      loading="eager"
      fetchpriority="high"
    />
  </div>
</section>

  <!-- ── STUDY CALLOUT ── -->
  <section class="study-callout v2-strip">
    <p><strong>{STUDY.name}:</strong> Participation closed {STUDY.closedOn}. The report is anticipated in {STUDY.reportAnticipated}. <a href="/study#report-updates">Get Report Updates →</a></p>
  </section>

  <!-- ── MISSION + PRINCIPLES (cream) ── -->
  <section class="v2-sec v2-cream v2-mission">
    <div class="v2-wrap">
      <div class="v2-label">What we believe</div>
      <h2 class="v2-h2">Listen. Communicate. Take Responsibility.</h2>
      <p class="v2-lede">{MISSION}</p>
      <div class="v2-principles">
        {PRINCIPLES.map((p) => (
          <div class="v2-principle">
            <h3>{p.label}</h3>
            <p>{p.lead && <strong>{p.lead} </strong>}{p.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── WORK AREAS (navy, photo cards) ── -->
  <section class="v2-sec v2-navy">
    <div class="v2-wrap">
      <div class="v2-label">Our work</div>
      <h2 class="v2-h2">Three Areas.<br>One Purpose.</h2>
      <p class="v2-sub">
        Research, career awareness, and industry engagement around one purpose: helping the industry take responsibility for its future workforce.
      </p>
      <div class="v2-work">
        {WORK_AREAS.map((w) => {
          const im = workImages[w.title];
          return (
            <article class="v2-wcard">
              {im && (
                <div class={`v2-wimg v2-tone-${im.tone}`}>
                  <Image src={im.src} alt={im.alt} widths={[400, 600, 800]} sizes="(max-width: 860px) 100vw, 33vw" loading="lazy" style={im.focus ? `object-position: ${im.focus}` : undefined} />
                </div>
              )}
              <div class="v2-wbody">
                <div class="v2-wnum">{w.num} — {w.title}</div>
                <h3>{w.title}</h3>
                <p>{w.line}</p>
                <a class="v2-wlink" href={w.href}>{w.cta} →</a>
              </div>
            </article>
          );
        })}
      </div>
      <div class="v2-more"><a href="/our-work" class="btn-hero">Explore Our Work</a></div>
    </div>
  </section>

  <!-- ── FEATURED RESEARCH (cream editorial) ── -->
  <section class="v2-sec v2-cream v2-study">
    <div class="v2-wrap v2-study-grid">
      <div class="v2-study-copy">
        <div class="v2-label">Featured research</div>
        <h2 class="v2-h2">Georgia Construction<br>Talent Study</h2>
        <p class="v2-lede">
          Participation closed {STUDY.closedOn}. The report is anticipated in {STUDY.reportAnticipated}. Sign up to hear when it is available.
        </p>
        <div class="v2-ctas">
          <a href="/study#report-updates" class="v2-btn v2-btn--solid">Get Report Updates</a>
          <a class="v2-btn" href="/study">View the Study →</a>
        </div>
      </div>
      <div class="v2-study-art">
        <div class="v2-blueprint" aria-hidden="true"></div>
        <dl class="v2-facts">
          <div><dt>Focus</dt><dd>Georgia</dd></div>
          <div><dt>Participation</dt><dd>Closed {STUDY.closedOn}</dd></div>
          <div><dt>Report</dt><dd>Anticipated {STUDY.reportAnticipated}</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <!-- ── CAREERS ── -->
  <section class="audiences v2-careers" id="careers">
    <div class="v2-wrap">
      <div class="v2-label v2-label--light">Construction careers</div>
      <h2 class="v2-h2">There’s More Than One Way<br>to Build a Career.</h2>
      <p class="v2-sub v2-sub--light">Explore the trades and discover training pathways. Our current salary information and training directory focus on Georgia.</p>
      <div class="v2-cgrid">
        <a class="v2-ccard" href="/careers#trades">
          <h3>Find Your Trade</h3>
          <p>Explore trade profiles by your interests and the way you like to work, with Georgia pay information.</p>
          <span class="v2-cgo">Find Your Trade →</span>
        </a>
        <a class="v2-ccard" href="/find-training">
          <h3>Find Training</h3>
          <p>Discover Georgia apprenticeship programs, trade schools, and college pathways, organized by trade.</p>
          <span class="v2-cgo">Find Training →</span>
        </a>
      </div>
    </div>
  </section>

  {AMERICAN_TRADES_PUBLISHED && (
    <section class="pillars">
      <div class="section-label">The American Trades</div>
      <h2>The People. The Skills.<br>The Work That Builds America.</h2>
      <a class="pillar-link" href="/american-trades">Explore The American Trades →</a>
    </section>
  )}

  <!-- ── ABOUT (navy) ── -->
  <section class="quote-section v2-about">
    <div class="quote-inner">
      <div class="quote-headshot">
        <Image
          src={headshot}
          alt="Liz Manning"
          widths={[300, 600, 944]}
          sizes="(max-width: 700px) 60vw, 300px"
        />
      </div>
      <div class="quote-content">
        <div class="section-label">Built through experience</div>
        <p class="quote-main">Meet Liz Manning and learn how a career shaped by the field became TradeBuilt.</p>
        <a href="/about" class="btn-hero">Meet Liz</a>
      </div>
    </div>
  </section>

  <!-- ── CONNECT (TradeBuilt Blue) ── -->
  <section class="v2-sec v2-connect">
    <div class="v2-wrap">
      <div class="v2-label v2-label--light">Connect</div>
      <h2 class="v2-h2">Be Part of<br>What's Being Built.</h2>
      <p class="v2-sub v2-sub--light">
        Have a story worth sharing, an educational initiative, or an idea for collaboration? Let’s connect.
      </p>
      <div class="v2-ctas">
        <a href="/contact" class="btn-hero">Connect With TradeBuilt →</a>
      </div>
    </div>
  </section>

  <Partners />

  <!-- ── FOOTER CTA ── -->
  <section class="footer-cta">
    <div class="fc-grid"></div>
    <h2>The Future of the<br>Workforce Isn't Built<br>by <em>Accident.</em></h2>
   <div class="fc-btns">
      <a href="/careers#trades" class="btn-cream">Find Your Trade</a>
      <a href="/find-training" class="btn-cream">Find Training</a>
    </div>
    <div class="fc-mark">
      <img src="/TradeBuilt Logo_BuilderMark_NavyBckgdCreamLogo.png" alt="" />
    </div>
  </section>

  <Footer />
</Layout>

<style>
/* ── HERO ── */
.hero {
  display: grid;
  grid-template-columns: 1fr 1fr;
  min-height: 580px;
  border-bottom: 0.5px solid var(--tb-border);
  background: var(--tb-bg-deep);
  overflow: hidden;
  position: relative;
}

.hero-left {
  padding: 72px 48px 64px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  position: relative;
  z-index: 2;
}

.hero-right {
  position: relative;
  overflow: hidden;
}

.hero-right img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center center;
  display: block;
}

.hero-fade {
  position: absolute;
  top: 0; left: 0;
  width: 60%;
  height: 100%;
  background: linear-gradient(to right, #0e1520 0%, rgba(14,21,32,0.6) 60%, transparent 100%);
  z-index: 1;
  pointer-events: none;
}

.eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  font-size: 14px;
  font-weight: 600;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--tb-text-dim);
  margin-bottom: 28px;
  border: 0.5px solid var(--tb-border);
  padding: 6px 14px;
  width: fit-content;
}

.hero h1 {
  font-family: 'Barlow Condensed', sans-serif;
  font-weight: 900;
  font-size: 68px;
  line-height: 0.93;
  letter-spacing: -0.01em;
  text-transform: uppercase;
  color: var(--tb-text-cream);
  margin-bottom: 28px;
}

.hero h1 em {
  font-style: normal;
  color: transparent;
  -webkit-text-stroke: 1.5px var(--tb-text-cream);
}

.hero-body {
  max-width: 480px;
  font-size: 15px;
  line-height: 1.8;
  color: var(--tb-text-dim);
  margin-bottom: 40px;
}

.hero-body strong { color: var(--tb-text-cream); font-weight: 500; }

.cta-row { display: flex; gap: 10px; flex-wrap: wrap; }

.btn-hero {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 15px;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  background: transparent;
  color: var(--tb-text-cream);
  border: 1px solid var(--tb-text-cream);
  padding: 12px 20px;
  cursor: pointer;
  text-decoration: none;
  display: inline-block;
  transition: background 0.2s, color 0.2s;
}

.btn-hero:hover {
  background: var(--tb-text-cream);
  color: var(--tb-bg-deep);
}

.btn-orange {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 15px;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  background: transparent;
  color: #c17830;
  border: 1px solid #c17830;
  padding: 12px 20px;
  cursor: pointer;
  text-decoration: none;
  display: inline-block;
  transition: background 0.2s, color 0.2s;
}

.btn-orange:hover {
  background: #c17830;
  color: var(--tb-bg-deep);
}

@media (max-width: 768px) {
  .hero {
    grid-template-columns: 1fr;
    min-height: auto;
  }

  .hero-right {
    height: 280px;
  }

  .hero-left {
    padding: 48px 24px 40px;
  }

  .hero h1 { font-size: 48px; }

  .cta-row { flex-direction: column; }
  .cta-row a { text-align: center; }
}

/* ── STUDY CALLOUT ── */
.study-callout {
  padding: 16px 40px;
  border-bottom: 0.5px solid var(--tb-border);
  background: #c17830;
  text-align: center;
}

.study-callout p {
  font-size: 14px;
  color: var(--tb-text-on-orange);
  letter-spacing: 0.02em;
  margin: 0;
}

.study-callout strong {
  color: var(--tb-text-on-orange);
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  margin-right: 6px;
}

.study-callout a {
  color: var(--tb-text-on-orange);
  text-decoration: none;
  border-bottom: 1px solid var(--tb-text-on-orange);
  margin-left: 6px;
  font-weight: 700;
}

@media (max-width: 768px) {
  .study-callout {
    padding: 14px 24px;
  }

  .study-callout p {
    font-size: 13px;
  }
}

  /* ── REALITY ── */
  .reality {
    padding: 64px 40px;
    border-bottom: 0.5px solid var(--tb-border);
    background: var(--tb-bg-base);
  }

  .reality h2 {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 900;
    font-size: 64px;
    line-height: 1.05;
    text-transform: uppercase;
    color: var(--tb-text-cream);
    margin-bottom: 20px;
    max-width: 560px;
  }

  .reality-intro {
    font-size: 18px;
    line-height: 1.75;
    color: var(--tb-text-dim);
    margin-bottom: 32px;
    max-width: 620px;
  }

  .reality-intro strong { color: var(--tb-text-cream); font-weight: 500; }

  .solution-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border: 0.5px solid var(--tb-border);
  }

  .solution-item {
    padding: 20px 22px;
    border-bottom: 0.5px solid var(--tb-border);
    border-right: 0.5px solid var(--tb-border);
  }

  .solution-item:nth-child(2n) { border-right: none; }
  .solution-item:nth-last-child(-n+2) { border-bottom: none; }

  .solution-item h4 {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 20px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--tb-text-cream);
    margin-bottom: 4px;
  }

  .solution-item p { font-size: 18px; color: var(--tb-text-dim); line-height: 1.55; margin: 0; }

  /* ── PILLARS ── */
  .pillars {
    padding: 64px 40px;
    border-bottom: 0.5px solid var(--tb-border);
    background: var(--tb-bg-deep);
  }

  .pillars h2 {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 900;
    font-size: 64px;
    line-height: 1;
    text-transform: uppercase;
    color: var(--tb-text-cream);
    margin-bottom: 8px;
  }

  .pillars-sub {
    font-size: 18px;
    color: var(--tb-text-dim);
    margin-bottom: 40px;
    max-width: 540px;
    line-height: 1.75;
  }

  .pillar-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border: 0.5px solid var(--tb-border);
  }

  .pillar { padding: 32px 24px; border-right: 0.5px solid var(--tb-border); }
  .pillar:last-child { border-right: none; }

  .pillar-num {
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--tb-text-dark);
    margin-bottom: 24px;
    text-transform: uppercase;
  }

  .pillar-icon {
    width: 32px; height: 32px;
    border: 1px solid var(--tb-border-mid);
    display: flex; align-items: center; justify-content: center;
    margin-bottom: 18px;
    color: var(--tb-text-cream);
  }

  .pillar h3 {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 20px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--tb-text-cream);
    margin-bottom: 10px;
    line-height: 1.15;
  }

  .pillar p { font-size: 16px; line-height: 1.65; color: var(--tb-text-dim); margin-bottom: 20px; }

  .pillar-link {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--tb-text-cream);
    text-decoration: none;
    border-bottom: 1px solid var(--tb-border-mid);
    padding-bottom: 2px;
  }

  /* ── AUDIENCES ── */
  .audiences {
    padding: 64px 40px;
    border-bottom: 0.5px solid var(--tb-border);
    background: linear-gradient(180deg, rgba(14,21,32,0.9), rgba(14,21,32,0.82)), url('/photo-aerial-atlanta.webp') center / cover no-repeat;
  }

  .audiences h2 {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 64px;
    font-weight: 900;
    text-transform: uppercase;
    color: var(--tb-text-cream);
    margin-bottom: 32px;
  }

  .aud-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; }

  .aud-card {
    background: rgba(14, 21, 32, 0.55);
    border: 0.5px solid var(--tb-border-mid);
    padding: 24px 20px;
  }

  .aud-card h4 {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 20px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--tb-text-cream);
    margin-bottom: 12px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--tb-border-mid);
  }

  .aud-card p { font-size: 16px; line-height: 1.65; color: var(--tb-text-cream); }

  .aud-ecosystem {
    margin-top: 28px;
    width: 100%;
    padding: 22px 28px;
    text-align: center;
    font-size: 16px;
    font-weight: 700;
    line-height: 1.7;
    color: var(--tb-bg-deep);
    background: var(--tb-text-cream);
  }

/* ── QUOTE SECTION ── */
  .quote-section {
    padding: 80px 40px;
    border-bottom: 0.5px solid var(--tb-border);
    background: var(--tb-bg-base);
  }

  .quote-inner {
    display: flex;
    align-items: center;
    gap: 56px;
    max-width: 780px;
    margin: 0 auto;
  }

  .quote-headshot {
    flex-shrink: 0;
    width: 180px;
    height: 180px;
    border-radius: 50%;
    overflow: hidden;
    border: 3px solid var(--tb-border-mid);
    box-shadow: 0 0 0 6px var(--tb-bg-deep);
  }

  .quote-headshot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }

  .quote-content {
    flex: 1;
  }

  .quote-marks {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 80px;
    font-weight: 900;
    color: var(--tb-border-mid);
    line-height: 0.6;
    margin-bottom: 16px;
  }

  .quote-main {
    font-size: 16px;
    line-height: 1.8;
    color: var(--tb-text-cream);
    font-style: italic;
    margin-bottom: 20px;
  }

  .quote-attribution {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--tb-text-dim);
    padding-top: 16px;
    border-top: 0.5px solid var(--tb-border);
  }
  /* ── PARTNER ── */
  .partner {
    padding: 64px 40px;
    border-bottom: 0.5px solid var(--tb-border);
    background: var(--tb-bg-base);
  }

  .partner h2 {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 64px;
    font-weight: 900;
    text-transform: uppercase;
    color: var(--tb-text-cream);
    margin-bottom: 8px;
  }

  .partner-sub {
    font-size: 18px;
    color: var(--tb-text-dim);
    max-width: 460px;
    line-height: 1.7;
    margin-bottom: 32px;
  }

  .partner-list {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr 1fr;
    border: 0.5px solid var(--tb-border);
  }

  .partner-list li {
    padding: 13px 18px;
    font-size: 18px;
    color: var(--tb-text-muted);
    border-bottom: 0.5px solid var(--tb-border);
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .partner-list li::before {
    content: '';
    display: block;
    width: 4px; height: 4px;
    background: var(--tb-text-cream);
    flex-shrink: 0;
  }

  .partner-list li:nth-last-child(-n+2) { border-bottom: none; }

  .partner-ctas {
    display: flex;
    align-items: center;
    gap: 28px;
    flex-wrap: wrap;
    margin-top: 8px;
  }

  /* ── FOOTER CTA ── */
  .footer-cta {
    padding: 72px 40px;
    text-align: center;
    position: relative;
    overflow: hidden;
    background: var(--tb-bg-deep);
  }

  .fc-grid {
    position: absolute; top: 0; left: 0; right: 0; bottom: 0;
    background-image:
      linear-gradient(rgba(232,227,213,0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(232,227,213,0.03) 1px, transparent 1px);
    background-size: 48px 48px;
    pointer-events: none;
  }

  .footer-cta h2 {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 80px;
    font-weight: 900;
    text-transform: uppercase;
    color: var(--tb-text-cream);
    line-height: 0.95;
    margin-bottom: 36px;
    position: relative;
  }

  .footer-cta h2 em {
    font-style: normal;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--tb-text-cream);
  }

  .fc-btns {
    display: flex;
    gap: 12px;
    justify-content: center;
    position: relative;
  }
.fc-mark {
    position: relative;
    margin-top: 40px;
  }

  .fc-mark img {
    width: 80px;
    height: 80px;
    object-fit: contain;
    opacity: 0.6;
  }
  /* ── SITE FOOTER ── */
  .site-footer {
    padding: 18px 40px;
    border-top: 0.5px solid var(--tb-border);
    display: flex;
