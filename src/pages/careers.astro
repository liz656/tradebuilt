---
import Layout from '../components/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { trades } from '../data/trades.js';

const money = (s) => parseInt(String(s).replace(/[$,]/g, ''), 10);
const wk = (s) => '$' + Math.round(money(s) / 1000) + 'K';

const cards = trades.map((t) => {
  const w = t.detail.wages;
  const pre = w.approx ? '~' : '';
  return {
    slug: t.slug,
    name: t.name,
    icon: t.icon,
    tags: t.tags,
    range: pre + wk(w.gaEntryAnnual) + '–' + pre + wk(w.gaTopAnnual),
    top: money(w.gaTopAnnual),
  };
});

const groups = [
  { label: 'What draws you', chips: [
    ['build', 'Build new things'], ['fix', "Fix what's broken"], ['operate', 'Operate machines'],
    ['design', 'Design systems'], ['solo', 'Work solo'] ] },
  { label: 'Where & how', chips: [
    ['outdoors', 'Work outside'], ['handson', 'Hands-on'], ['heights', 'Heights'],
    ['tech', 'Tech-forward'], ['office', 'Office option'], ['fast', 'Fast to start'] ] },
];
const labelFor = (tg) => groups.flatMap((g) => g.chips).find((ch) => ch[0] === tg)[1];
---

<Layout title="Find Your Trade — Construction Careers in Georgia | TradeBuilt" description="Explore construction careers in Georgia. Twelve skilled trades with real wages, real training, and a real future.">
  <Nav />

  <header class="fyt-hero">
    <div class="fyt-wrap">
      <div class="fyt-eyebrow">Explore Construction Careers</div>
      <h1>Real Careers.<br>Built to <em>Last.</em></h1>
      <p class="fyt-lede">Georgia construction is hiring. The trades pay real wages, teach real skills, and build careers you can stand on. Find where you fit and who can train you.</p>
      <div class="fyt-cta">
        <a href="#trades" class="btn-cream">Find Your Trade</a>
        <a href="/find-training" class="btn-outline">Find Training</a>
      </div>
    </div>
  </header>

  <section class="fyt-triage">
    <div class="fyt-wrap">
      <div class="fyt-lbl">Where you are</div>
      <h2>Everybody Starts <em>Somewhere.</em></h2>
      <div class="tri-grid">
        <button class="tri" data-path="school" data-chip="handson"><span class="tn">01 / In school</span><h3>Still in School</h3><p>See what the trades actually look like and get a head start before you graduate.</p><span class="go">Start exploring &rarr;</span></button>
        <button class="tri" data-path="grad" data-chip="fast"><span class="tn">02 / Recent grad</span><h3>Recent Grad</h3><p>Turn your diploma into a paid apprenticeship and a career that keeps climbing.</p><span class="go">Find your first step &rarr;</span></button>
        <button class="tri" data-path="change"><span class="tn">03 / Career change</span><h3>Career Change</h3><p>Bring your work ethic to a field that values it and pays you to learn a real skill.</p><span class="go">Explore the trades &rarr;</span></button>
      </div>
    </div>
  </section>

  <section class="fyt-filterband" id="trades">
    <div class="fyt-wrap">
      <div class="fyt-lead">
        <div class="fyt-lbl accent">Find your trade</div>
        <h2 id="filterHeadline">What do you want <em>out of work?</em></h2>
        <p id="filterSub">Tap what matters to you. We'll show the Georgia trades that fit, and what they pay.</p>
      </div>
    </div>
    <div class="fyt-controls">
      <div class="fyt-wrap">
        {groups.map((g) => (
          <div class="chipgroup">
            <span class="cglabel">{g.label}</span>
            <div class="chiprow">
              {g.chips.map(([k, l]) => <button class="chip" data-tag={k}>{l}</button>)}
            </div>
          </div>
        ))}
        <div class="meta">
          <span class="count"><b id="cnum">12</b> trades match</span>
          <div class="sortwrap"><span class="sortlbl">Sort</span><button class="sortbtn on" data-sort="az">A&ndash;Z</button><button class="sortbtn" data-sort="pay">Top pay</button></div>
          <button class="reset" id="reset">Reset</button>
        </div>
      </div>
    </div>
    <div class="fyt-gridwrap">
      <div class="fyt-wrap">
        <div class="grid" id="grid">
          {cards.map((c) => (
            <a class="tcard" href={`/trades/${c.slug}`} data-top={c.top} data-tags={c.tags.join(' ')}>
              <div class="seal" set:html={c.icon}></div>
              <h3>{c.name}</h3>
              <div class="twage">{c.range}<span class="tper">/yr in GA &middot; entry to top</span></div>
              <div class="pills">{c.tags.map((tg) => <span class="pill">{labelFor(tg)}</span>)}</div>
              <span class="tgo">Explore this trade &rarr;</span>
            </a>
          ))}
        </div>
        <div class="empty" id="empty">No trade matches all of that. Try loosening a filter.</div>
      </div>
    </div>
  </section>

  <section class="fyt-partner" id="partner">
    <div class="fyt-wrap">
      <div class="fyt-lbl accent" style="justify-content:center;">For training providers</div>
      <h2>Are You Training the <em>Next Generation?</em></h2>
      <p>If you run an apprenticeship or training program in Georgia and don't see it listed, let's fix that. Reach out and I'll get you on the map.</p>
      <a href="mailto:liz@tradebuiltga.com" class="btn-cream">Contact Liz</a>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .fyt-wrap { max-width: 1200px; margin: 0 auto; padding: 0 40px; }
  h1, h2, h3 { font-family: 'Barlow Condensed', sans-serif; text-transform: uppercase; letter-spacing: -0.01em; line-height: 0.98; }
  h1 em, h2 em { font-style: normal; color: transparent; -webkit-text-stroke: 1.2px var(--tb-text-cream); }
  .fyt-eyebrow, .fyt-lbl { font-size: 10px; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; color: var(--tb-text-faint); margin-bottom: 20px; }
  .fyt-eyebrow, .fyt-lbl.accent { color: #c17830; }
  .btn-cream { font-family: 'Barlow Condensed', sans-serif; font-size: 14px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; padding: 14px 28px; text-decoration: none; display: inline-block; background: var(--tb-text-cream); color: var(--tb-bg-base); }
  .btn-outline { font-family: 'Barlow Condensed', sans-serif; font-size: 14px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; padding: 14px 28px; text-decoration: none; display: inline-block; background: transparent; color: var(--tb-text-cream); border: 1px solid var(--tb-border-mid); }

  .fyt-hero { position: relative; min-height: 520px; display: flex; align-items: center; border-bottom: 0.5px solid var(--tb-border);
    background: linear-gradient(90deg, rgba(10,14,20,0.9) 0%, rgba(10,14,20,0.6) 50%, rgba(10,14,20,0.32) 100%), url('/photo-apprenticeship.webp') center / cover no-repeat; }
  .fyt-hero h1 { font-weight: 900; font-size: 74px; color: var(--tb-text-cream); margin-bottom: 22px; }
  .fyt-lede { font-size: 19px; color: #d8d3c6; max-width: 540px; margin-bottom: 34px; }
  .fyt-cta { display: flex; gap: 14px; flex-wrap: wrap; }

  .fyt-triage { padding: 88px 0; background: var(--tb-bg-base); }
  .fyt-triage h2, .fyt-filterband h2, .fyt-partner h2 { font-weight: 900; font-size: 44px; color: var(--tb-text-cream); margin-bottom: 44px; }
  .tri-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
  .tri { text-align: left; border: 0.5px solid var(--tb-border); background: var(--tb-bg-deep); padding: 34px 30px; cursor: pointer; transition: border-color 0.2s, transform 0.2s; font-family: inherit; color: inherit; }
  .tri:hover { border-color: var(--tb-border-mid); transform: translateY(-4px); }
  .tri .tn { font-size: 10px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--tb-text-faint); }
  .tri h3 { font-weight: 700; font-size: 26px; color: var(--tb-text-cream); margin: 12px 0 10px; }
  .tri p { font-size: 15px; color: var(--tb-text-muted); margin-bottom: 16px; line-height: 1.6; }
  .tri .go { font-family: 'Barlow Condensed', sans-serif; font-size: 13px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: #c17830; }

  .fyt-filterband { background: var(--tb-bg-deep); border-top: 0.5px solid var(--tb-border); padding-top: 80px; }
  .fyt-lead { max-width: 560px; margin-bottom: 32px; }
  .fyt-lead h2 { font-weight: 900; font-size: 44px; color: var(--tb-text-cream); }
  #filterHeadline { transition: opacity 0.22s ease; }
  .fyt-lead p { font-size: 17px; color: var(--tb-text-muted); margin-top: 12px; }
  .fyt-controls { position: sticky; top: 0; z-index: 20; background: var(--tb-bg-deep); padding: 14px 0 30px; }
  .chipgroup { margin-bottom: 16px; }
  .cglabel { display: block; font-size: 10px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--tb-text-faint); margin-bottom: 9px; }
  .chiprow { display: flex; flex-wrap: wrap; gap: 10px; }
  .chip { font-family: 'Barlow Condensed', sans-serif; font-size: 14px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--tb-text-dim); background: transparent; border: 1px solid var(--tb-border-mid); padding: 9px 17px; border-radius: 999px; cursor: pointer; transition: 0.15s; }
  .chip:hover { color: var(--tb-text-cream); border-color: var(--tb-text-cream); }
  .chip.on { background: #c17830; border-color: #c17830; color: #1a1206; }
  @keyframes chipPulse { 0% { box-shadow: 0 0 0 0 rgba(193,120,48,0.55); } 70% { box-shadow: 0 0 0 14px rgba(193,120,48,0); } 100% { box-shadow: 0 0 0 0 rgba(193,120,48,0); } }
  .chip.pulse { animation: chipPulse 0.7s ease-out 2; }
  .meta { display: flex; align-items: center; flex-wrap: wrap; gap: 14px 20px; margin-top: 16px; }
  .count { font-family: 'Barlow Condensed', sans-serif; font-weight: 700; font-size: 15px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--tb-text-cream); }
  .count b { color: #c17830; }
  .sortwrap { display: inline-flex; align-items: center; gap: 8px; }
  .sortlbl { font-size: 11px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--tb-text-faint); }
  .sortbtn { font-family: 'Barlow Condensed', sans-serif; font-size: 12px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--tb-text-dim); background: transparent; border: 1px solid var(--tb-border-mid); padding: 5px 13px; border-radius: 999px; cursor: pointer; transition: 0.15s; }
  .sortbtn:hover { color: var(--tb-text-cream); border-color: var(--tb-text-cream); }
  .sortbtn.on { background: var(--tb-text-cream); color: var(--tb-bg-base); border-color: var(--tb-text-cream); }
  .reset { font-size: 12px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--tb-text-dim); background: none; border: none; cursor: pointer; font-family: 'Barlow Condensed', sans-serif; }
  .reset:hover { color: var(--tb-text-cream); }

  .fyt-gridwrap { background: var(--tb-bg-deep); padding: 20px 0 96px; }
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .tcard { position: relative; overflow: hidden; text-align: center; text-decoration: none; background: #eae4d5; color: var(--tb-bg-deep); border: 0.5px solid rgba(14,21,32,0.12); padding: 30px 26px; transition: transform 0.2s, box-shadow 0.2s; display: flex; flex-direction: column; align-items: center; }
  .tcard::before { content: ''; position: absolute; inset: 0; z-index: 0; pointer-events: none; background: url('/grain.webp'); background-size: 200px 200px; }
  .tcard > * { position: relative; z-index: 1; }
  .tcard:hover { transform: translateY(-5px); box-shadow: 0 18px 40px rgba(0,0,0,0.4); }
  .tcard.hide { display: none; }
  @keyframes cardIn { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: translateY(0); } }
  .tcard.reveal { animation: cardIn 0.5s ease both; }
  .seal { width: 112px; height: 112px; color: #1c2b3a; margin-bottom: 12px; transition: color 0.25s; }
  .seal :global(svg) { width: 100%; height: 100%; display: block; }
  .tcard:hover .seal { color: #c17830; }
  .tcard h3 { font-weight: 700; font-size: 21px; letter-spacing: 0.02em; color: var(--tb-bg-deep); margin-bottom: 8px; }
  .twage { font-family: 'Barlow Condensed', sans-serif; font-weight: 900; font-size: 31px; line-height: 1; color: var(--tb-bg-deep); }
  .tper { display: block; font-family: 'Barlow', sans-serif; font-weight: 600; font-size: 10.5px; letter-spacing: 0.03em; text-transform: uppercase; color: rgba(14,21,32,0.55); margin-top: 6px; }
  .pills { display: flex; flex-wrap: wrap; gap: 6px; justify-content: center; margin: 14px 0 16px; }
  .pill { font-size: 10px; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; color: #5a6880; border: 0.5px solid rgba(14,21,32,0.2); padding: 3px 9px; border-radius: 999px; }
  .tgo { margin-top: auto; font-family: 'Barlow Condensed', sans-serif; font-size: 12px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: #c17830; }
  .empty { display: none; text-align: center; padding: 50px 0; color: var(--tb-text-muted); font-size: 16px; }
  .empty.show { display: block; }

  .fyt-partner { background: var(--tb-bg-base); border-top: 0.5px solid var(--tb-border); text-align: center; padding: 96px 0; }
  .fyt-partner h2 { font-weight: 900; font-size: 50px; color: var(--tb-text-cream); max-width: 16ch; margin: 0 auto 18px; }
  .fyt-partner p { font-size: 17px; color: var(--tb-text-muted); max-width: 560px; margin: 0 auto 30px; line-height: 1.7; }

  @media (max-width: 820px) {
    .grid, .tri-grid { grid-template-columns: 1fr 1fr; }
    .fyt-hero h1 { font-size: 46px; }
    .fyt-controls { position: static; padding: 10px 0 20px; }
    .chiprow { flex-wrap: nowrap; overflow-x: auto; -webkit-overflow-scrolling: touch; scrollbar-width: none; padding-bottom: 2px; }
    .chiprow::-webkit-scrollbar { display: none; }
    .chip { flex: 0 0 auto; font-size: 12.5px; padding: 8px 14px; }
    .cglabel { margin-bottom: 6px; }
    .chipgroup { margin-bottom: 12px; }
  }
  @media (max-width: 480px) {
    .grid, .tri-grid { grid-template-columns: 1fr; }
    .fyt-wrap { padding: 0 22px; }
  }
</style>

<script>
  const active = new Set();
  const cards = [...document.querySelectorAll('.tcard')];
  const chips = [...document.querySelectorAll('.chip')];
  const cnum = document.getElementById('cnum');
  const empty = document.getElementById('empty');
  const HEAD = document.getElementById('filterHeadline');
  const SUB = document.getElementById('filterSub');
  const grid = document.getElementById('grid');
  const DEF_H = HEAD.innerHTML, DEF_S = SUB.textContent;
  const origOrder = [...cards];
  let sortMode = 'az';
  const PATHS = {
    school: { h: "You're Just Getting <em>Started.</em>", s: 'See where hands-on trades begin. Tap anything to keep exploring.' },
    grad: { h: 'Fresh Out of <em>School?</em>', s: 'Here are the trades you can start fast and get paid to learn.' },
    change: { h: 'Ready for a <em>Change?</em>', s: "Bring your work ethic to a trade that pays and values it — here's the full range." },
  };
  function apply() {
    let n = 0;
    cards.forEach((c) => {
      const t = c.dataset.tags.split(' ');
      const ok = [...active].every((x) => t.includes(x));
      c.classList.toggle('hide', !ok);
      if (ok) n++;
    });
    cnum.textContent = n;
    empty.classList.toggle('show', n === 0);
  }
  function setChip(tag, on) {
    const el = chips.find((c) => c.dataset.tag === tag);
    if (!el) return;
    if (on) { active.add(tag); el.classList.add('on'); }
    else { active.delete(tag); el.classList.remove('on'); }
  }
  function countMatches() { return cards.filter((c) => !c.classList.contains('hide')).length; }
  function animateCount(to) {
    const from = +cnum.textContent || 0;
    if (from === to) { cnum.textContent = to; return; }
    const st = performance.now(), dur = 700;
    (function step(t) { const p = Math.min((t - st) / dur, 1); cnum.textContent = Math.round(from + (to - from) * p); if (p < 1) requestAnimationFrame(step); })(performance.now());
  }
  function staggerReveal() {
    let i = 0;
    cards.forEach((c) => { if (!c.classList.contains('hide')) { c.classList.remove('reveal'); void c.offsetWidth; c.style.animationDelay = (i * 45) + 'ms'; c.classList.add('reveal'); i++; } });
  }
  function sortCards() {
    const arr = sortMode === 'pay' ? [...cards].sort((a, b) => (+b.dataset.top) - (+a.dataset.top)) : origOrder.slice();
    arr.forEach((c) => grid.appendChild(c));
  }
  chips.forEach((ch) => ch.addEventListener('click', () => { const t = ch.dataset.tag; active.has(t) ? setChip(t, false) : setChip(t, true); apply(); }));
  document.querySelectorAll('.sortbtn').forEach((btn) => btn.addEventListener('click', () => { document.querySelectorAll('.sortbtn').forEach((b) => b.classList.remove('on')); btn.classList.add('on'); sortMode = btn.dataset.sort; sortCards(); }));
  document.getElementById('reset').addEventListener('click', () => { active.clear(); chips.forEach((c) => c.classList.remove('on')); apply(); HEAD.innerHTML = DEF_H; SUB.textContent = DEF_S; });
  document.querySelectorAll('.tri').forEach((t) => t.addEventListener('click', () => {
    active.clear(); chips.forEach((c) => c.classList.remove('on'));
    if (t.dataset.chip) setChip(t.dataset.chip, true);
    apply();
    const finalN = countMatches();
    cnum.textContent = 12;
    const p = PATHS[t.dataset.path];
    document.getElementById('trades').scrollIntoView({ behavior: 'smooth' });
    setTimeout(() => {
      if (p) { HEAD.style.opacity = 0; setTimeout(() => { HEAD.innerHTML = p.h; SUB.textContent = p.s; HEAD.style.opacity = 1; }, 210); }
      if (t.dataset.chip) { const ch = chips.find((c) => c.dataset.tag === t.dataset.chip); if (ch) { ch.classList.remove('pulse'); void ch.offsetWidth; ch.classList.add('pulse'); } }
      animateCount(finalN); staggerReveal();
    }, 430);
  }));
</script>
