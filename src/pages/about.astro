---
import { Image } from 'astro:assets';
import Layout from '../components/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Partners from '../components/Partners.astro';
import aecaBooth from '../assets/AECABooth.jpg';
import skillsUsa from '../assets/SkillsUSAGeorgia2024.jpg';
import speaking from '../assets/SkillsChallenge2025_Speaking.jpg';
import necaPodcast from '../assets/NECAPodcast.jpg';
import { visiblePodcasts } from '../data/podcasts.js';
import { PRINCIPLES } from '../data/site.js';
const gridCasts = visiblePodcasts.filter((p) => !p.featured);
const featuredCasts = visiblePodcasts.filter((p) => p.featured);
---

<Layout title="About Liz Manning &amp; TradeBuilt" description="Meet Liz Manning and learn how field experience, industry relationships, and construction workforce conversations shaped TradeBuilt.">
  <Nav />

  <!-- ── HERO ── -->
  <section class="about-hero">
    <div class="blueprint"></div>
    <div class="hero-content">
      <div class="eyebrow">About Liz Manning</div>
      <h1>They Are<br>The <em>Heroes.</em></h1>
      <p class="hero-sub">Educators. Contractors. Apprentices. The people building something real every day.</p>
    </div>
  </section>

  <!-- ── BIO OPENING: small photo left, large pull quote right ── -->
  <section class="bio-opening">
    <div class="bio-opening-photo">
      <Image
        src={aecaBooth}
        alt="Liz Manning at AECA"
        widths={[308, 616]}
        sizes="(max-width: 700px) 80vw, 308px"
        loading="eager"
      />
    </div>
    <div class="bio-opening-text">
      <h2 class="bio-pull">I’m Liz Manning. My career was built by the field.</h2>
      <p>I didn’t come from a trades background, and I didn’t take a traditional path into construction.</p>
      <p>My career was built through relationships, work ethic, and learning the industry from the people who know it best.</p>
    </div>
  </section>

  <!-- ── BIO CONTINUED ── -->
  <section class="bio-continued">
    <div class="bio-text">
      <p>For the past decade, I’ve worked alongside general contractors, specialty contractors, trade associations, apprenticeship programs, and workforce organizations. I’ve seen what happens when the right people and programs come together, and what happens when they don’t.</p>
      <p>Those experiences eventually led me to create TradeBuilt. <strong>I believed the people closest to the work deserved a bigger voice in the conversations shaping its future.</strong></p>
      <p>That work has taken many forms: building and operationalizing apprenticeship structures at the office, local, and federal level; leading superintendents and field teams; designing playbooks and integration systems that support field culture; raising money for high school construction programs; launching workforce alliances that connect contractors with classrooms; and building communication platforms that reflect the field.</p>
    </div>
  </section>

  <!-- ── PULL QUOTE + SkillsUSA photo right ── -->
  <section class="pull-quote-section">
    <div class="pq-layout">
      <div class="pq-content">
        <div class="pq-mark" aria-hidden="true">&ldquo;</div>
        <p class="pq-text">The work has never just been about programs. It’s about changing the conversation.</p>
      </div>
      <div class="pq-photo">
        <Image
          src={skillsUsa}
          alt="Skills USA Georgia 2024"
          widths={[488, 975]}
          sizes="(max-width: 700px) 80vw, 488px"
        />
      </div>
    </div>
  </section>

  <!-- ── BIO FINAL ── -->
  <section class="bio-final">
    <div class="bio-text">
      <p>Listening to the field means understanding what’s actually happening. Communicating opportunities means making sure the right people hear about them. Taking responsibility means recognizing that the industry’s future workforce won’t develop itself.</p>
      <p class="bio-emphasis">That’s the thinking behind TradeBuilt.</p>
    </div>
  </section>

  <!-- ── FULL WIDTH SPEAKING PHOTO ── -->
  <section class="speaking-strip">
    <Image
      src={speaking}
      alt="Liz Manning speaking at Skills Challenge 2025"
      widths={[720, 1080, 1440]}
      sizes="100vw"
    />
    <div class="speaking-caption">Skills Challenge 2025</div>
  </section>

  <!-- ── PODCASTS ── -->
  <section class="podcasts" id="conversations">
    <div class="podcasts-header">
      <div class="podcasts-header-text">
        <div class="section-label">Featured conversations</div>
        <h2>Conversations<br>From the Field.</h2>
        <p class="podcasts-intro">Some of the most important conversations about construction’s workforce happen outside conference rooms.</p>
        <p class="podcasts-intro">These discussions explore workforce development, industry branding, recruiting, and the people shaping what’s next.</p>
      </div>
      <div class="podcasts-header-photo">
        <Image
          src={necaPodcast}
          alt="Liz Manning at the NECA podcast"
          widths={[400, 799]}
          sizes="(max-width: 700px) 80vw, 400px"
        />
      </div>
    </div>

    <div class="recent-label">Recent Conversations</div>

    <div class="podcast-grid">
      {gridCasts.map((p) => (
        <a href={p.url} target="_blank" rel="noopener noreferrer" class="podcast-card" data-podcast-id={p.id}>
          <div class="podcast-meta">
            <span class="podcast-show">{p.show}</span>
            <span class="podcast-ep">{p.episode}</span>
          </div>
          <h4>{p.title}</h4>
          {p.description && <p class="podcast-desc">{p.description}</p>}
          <div class="podcast-platform">{p.platform}</div>
        </a>
      ))}
    </div>

    {featuredCasts.map((p) => (
      <a href={p.url} target="_blank" rel="noopener noreferrer" class="podcast-card podcast-card--full" data-podcast-id={p.id}>
        <div class="podcast-meta">
          <span class="podcast-show">{p.show}</span>
          <span class="podcast-ep">{p.episode}</span>
        </div>
        <h4>{p.title}</h4>
        {p.description && <p class="podcast-desc">{p.description}</p>}
        <div class="podcast-platform">{p.platform}</div>
      </a>
    ))}

  </section>

  <!-- ── PRINCIPLES (replaces How I Help) ── -->
  <section class="how-help">
    <div class="hh-inner">
      <div class="section-label">Principles</div>
      <h2>What Shapes <em>the Work.</em></h2>
      <div class="hh-grid">
        {PRINCIPLES.map((p) => (
          <div class="hh-item">
            <h3>{p.label}</h3>
            <p>{p.lead && <strong>{p.lead} </strong>}{p.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── CTA ── -->
  <section class="about-cta">
    <div class="fc-grid"></div>
    <p class="cta-pre">TradeBuilt continues to explore the people, opportunities, and challenges shaping construction’s future workforce.</p>
    <h2>Be Part of<br>What’s Being <em>Built.</em></h2>
    <p class="cta-pre cta-post">Have a story worth sharing, an educational initiative, or an idea for collaboration? Let’s connect.</p>
    <div class="cta-btns">
      <a href="/contact" class="btn-cream">Connect With TradeBuilt</a>
      <a href="/our-work" class="btn-outline">Explore Our Work</a>
    </div>
  </section>

  <Partners />

  <Footer />

</Layout>

<style>
  /* ── HOW I HELP ── */
  .how-help {
    background: var(--tb-bg-base);
    border-top: 0.5px solid var(--tb-border);
    padding: 88px 40px;
  }
  .hh-inner { max-width: 1000px; margin: 0 auto; }
  .how-help h2 {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 900; font-size: 46px; line-height: 1;
    text-transform: uppercase; letter-spacing: -0.01em;
    color: var(--tb-text-cream); margin-bottom: 20px;
  }
  .how-help h2 em {
    font-style: normal; color: transparent;
    -webkit-text-stroke: 1.2px var(--tb-text-cream);
  }
  .hh-lede {
    font-size: 17px; line-height: 1.7; color: var(--tb-text-muted);
    max-width: 720px; margin-bottom: 48px;
  }
  .hh-grid {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px;
    margin-bottom: 44px;
  }
  .hh-item { border-top: 2px solid #c17830; padding-top: 20px; }
  .hh-item h3 {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 700; font-size: 21px; text-transform: uppercase;
    letter-spacing: 0.01em; color: var(--tb-text-cream); margin-bottom: 12px;
  }
  .hh-item p { font-size: 14.5px; line-height: 1.7; color: var(--tb-text-dim); }
  .hh-item p strong { color: var(--tb-text-cream); font-weight: 600; }
  .podcast-card { min-width: 0; overflow-wrap: anywhere; }
  @media (max-width: 480px) { .podcast-grid { grid-template-columns: 1fr !important; } }
  .cta-post { margin: 0 auto 28px; max-width: 560px; }
  .about-cta .cta-pre { max-width: 620px; margin-left: auto; margin-right: auto; }
  .how-help h2 { margin-bottom: 40px; }
  .hh-close {
    font-size: 18px; font-style: italic; line-height: 1.6;
    color: var(--tb-text-cream); max-width: 720px;
    border-left: 3px solid #c17830; padding-left: 20px;
  }
  @media (max-width: 760px) {
    .how-help { padding: 56px 24px; }
    .hh-grid { grid-template-columns: 1fr; gap: 28px; }
    .how-help h2 { font-size: 36px; }
  }

  /* ── HERO ── */
  .about-hero {
    padding: 80px 40px 64px;
    border-bottom: 0.5px solid var(--tb-border);
    position: relative;
    overflow: hidden;
    background: var(--tb-bg-deep);
    text-align: center;
  }

  .blueprint {
    position: absolute; top: 0; left: 0; right: 0; bottom: 0;
    background-image:
      linear-gradient(rgba(232,227,213,0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(232,227,213,0.04) 1px, transparent 1px);
    background-size: 48px 48px;
    pointer-events: none;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 640px;
    margin: 0 auto;
  }

  .eyebrow {
    display: inline-flex;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--tb-text-dim);
    margin-bottom: 24px;
    border: 0.5px solid var(--tb-border);
    padding: 6px 14px;
  }

  .about-hero h1 {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 900;
    font-size: 80px;
    line-height: 0.93;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: var(--tb-text-cream);
    margin-bottom: 20px;
  }

  .about-hero h1 em {
    font-style: normal;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--tb-text-cream);
  }

  .hero-sub {
    font-size: 15px;
    line-height: 1.7;
    color: var(--tb-text-dim);
    max-width: 500px;
    margin: 0 auto;
    font-style: italic;
  }

  /* ── BIO OPENING ── */
.bio-opening {
    display: grid;
    grid-template-columns: 380px 1fr;
    gap: 0;
    border-bottom: 0.5px solid var(--tb-border);
    background: var(--tb-bg-base);
    min-height: 480px;
    max-width: 1100px;
    margin: 0 auto;
    width: 100%;
  }

  .bio-opening-photo {
    overflow: hidden;
    border-right: 0.5px solid var(--tb-border);
    flex-shrink: 0;
  }

  .bio-opening-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
  }

  .bio-opening-text {
    padding: 48px 48px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 16px;
  }

.bio-pull {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 26px;
    font-weight: 900;
    line-height: 1.15;
    color: var(--tb-text-cream);
    text-transform: uppercase;
    letter-spacing: 0.01em;
    margin-bottom: 12px;
    max-width: 480px;
  }

  .bio-opening-text p {
    font-size: 16px;
    line-height: 1.8;
    color: var(--tb-text-dim);
  }

  .bio-opening-text p strong {
    color: var(--tb-text-cream);
    font-weight: 500;
  }

  /* ── BIO CONTINUED ── */
.bio-continued {
    padding: 56px 40px;
    border-bottom: 0.5px solid var(--tb-border);
    background: var(--tb-bg-deep);
  }

.bio-continued .bio-text {
    max-width: 860px;
    margin: 0 auto;
    padding: 0 60px;
  }

  .bio-text {
    max-width: 760px;
    margin: 0 auto;
  }

  .bio-text p {
    font-size: 16px;
    line-height: 1.85;
    color: var(--tb-text-dim);
    margin-bottom: 18px;
  }

  .bio-text p:last-child { margin-bottom: 0; }

  .bio-text p strong {
    color: var(--tb-text-cream);
    font-weight: 500;
  }

  /* ── PULL QUOTE ── */
  .pull-quote-section {
    padding: 64px 40px;
    border-bottom: 0.5px solid var(--tb-border);
    background: var(--tb-bg-deep);
  }

  .pq-layout {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 56px;
    align-items: center;
    max-width: 900px;
    margin: 0 auto;
  }

  .pq-mark {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 80px;
    font-weight: 900;
    color: var(--tb-border-mid);
    line-height: 0.6;
    margin-bottom: 16px;
  }

  .pq-text {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 30px;
    font-weight: 700;
    line-height: 1.2;
    color: var(--tb-text-cream);
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .pq-photo {
    border: 0.5px solid var(--tb-border);
    overflow: hidden;
  }

  .pq-photo img {
    width: 100%;
    height: 320px;
    object-fit: cover;
    object-position: center top;
    display: block;
  }

  /* ── BIO FINAL ── */
  .bio-final {
    padding: 56px 40px;
    border-bottom: 0.5px solid var(--tb-border);
    background: var(--tb-bg-base);
  }

  .bio-emphasis {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 26px !important;
    font-weight: 700 !important;
    color: var(--tb-text-cream) !important;
    line-height: 1.2 !important;
    letter-spacing: 0.02em;
    margin: 4px 0 20px !important;
  }

  /* ── SPEAKING STRIP ── */
  .speaking-strip {
    position: relative;
    border-bottom: 0.5px solid var(--tb-border);
    overflow: hidden;
    height: 560px;
  }

  .speaking-strip img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 25%;
    display: block;
  }

  .speaking-caption {
    position: absolute;
    bottom: 20px;
    right: 24px;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(232,227,213,0.85);
    text-shadow: 0 1px 3px rgba(14,21,32,0.8);
  }

  /* ── PODCASTS ── */
.podcasts {
    padding: 64px 40px;
    border-bottom: 0.5px solid var(--tb-border);
    background: var(--tb-bg-base);
  }

.podcasts-header,
.podcast-grid,
.podcast-card--full,
.recent-label {
    max-width: 1100px;
    margin-left: auto;
    margin-right: auto;
  }

  .podcasts-header {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 48px;
    align-items: start;
    margin-bottom: 40px;
  }

  .podcasts-header-photo {
    border: 0.5px solid var(--tb-border);
    overflow: hidden;
  }

  .podcasts-header-photo img {
    width: 100%;
    height: 260px;
    object-fit: cover;
    object-position: center top;
    display: block;
  }

  .podcasts h2 {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 900;
    font-size: 42px;
    line-height: 1.05;
    text-transform: uppercase;
    color: var(--tb-text-cream);
    margin-bottom: 12px;
  }

  .podcasts-intro {
    font-size: 15px;
    color: var(--tb-text-dim);
    line-height: 1.7;
    margin-top: 12px;
  }

  .recent-label {
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--tb-text-ghost);
    margin-bottom: 16px;
    padding-bottom: 12px;
    border-bottom: 0.5px solid var(--tb-border);
  }

  .podcast-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
    margin-bottom: 10px;
  }

  .podcast-card {
    background: var(--tb-bg-deep);
    border: 0.5px solid var(--tb-border);
    padding: 18px;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    transition: border-color 0.2s;
  }

  .podcast-card:hover { border-color: var(--tb-border-mid); }

  .podcast-card--full {
    display: block;
    width: 100%;
    margin-top: 0;
  }

  .podcast-meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-bottom: 10px;
  }

  .podcast-show {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--tb-text-ghost);
    line-height: 1.4;
  }

  .podcast-ep {
    font-size: 13px;
    letter-spacing: 0.08em;
    color: var(--tb-text-faint);
    text-transform: uppercase;
  }

  .podcast-card h4 {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 16px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--tb-text-cream);
    line-height: 1.2;
    margin-bottom: 12px;
    flex: 1;
  }

  .podcast-desc {
    font-size: 15px;
    color: var(--tb-text-dim);
    line-height: 1.6;
    margin-bottom: 12px;
  }

  .podcast-platform {
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 5px 10px;
    display: inline-block;
    background: rgba(255,255,255,0.05);
    color: var(--tb-text-dim);
    border: 0.5px solid var(--tb-border);
    margin-top: auto;
    width: fit-content;
  }

  /* ── CTA ── */
  .about-cta {
    padding: 80px 40px;
    text-align: center;
    position: relative;
    overflow: hidden;
    background: linear-gradient(180deg, rgba(14,21,32,0.62), rgba(14,21,32,0.8)), url('/photo-steel-rust.webp') center / cover no-repeat;
  }

  .fc-grid {
    position: absolute; top: 0; left: 0; right: 0; bottom: 0;
    background-image:
      linear-gradient(rgba(232,227,213,0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(232,227,213,0.03) 1px, transparent 1px);
    background-size: 48px 48px;
    pointer-events: none;
  }

  .cta-pre {
    font-size: 15px;
    color: var(--tb-text-cream);
    letter-spacing: 0.04em;
    margin-bottom: 12px;
    position: relative;
    font-style: italic;
  }

  .about-cta h2 {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 52px;
    font-weight: 900;
    text-transform: uppercase;
    color: var(--tb-text-cream);
    line-height: 0.95;
    margin-bottom: 32px;
    position: relative;
  }

  .about-cta h2 em {
    font-style: normal;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--tb-text-cream);
  }

  .cta-btns {
    display: flex;
    gap: 12px;
    justify-content: center;
    position: relative;
  }

  /* ── FOOTER ── */
  .site-footer {
    padding: 18px 40px;
    border-top: 0.5px solid var(--tb-border);
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: var(--tb-bg-deep);
  }

  .footer-logo {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 900;
    font-size: 15px;
    color: var(--tb-text-ghost);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .footer-logo span { color: var(--tb-text-dark); }
  .footer-copy { font-size: 14px; color: var(--tb-text-dark); letter-spacing: 0.06em; }

  /* ── SECTION LABEL ── */
  .section-label {
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--tb-text-ghost);
    margin-bottom: 16px;
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .section-label::after {
    content: '';
    flex: 1;
    height: 0.5px;
    background: var(--tb-border);
  }

  /* ── MOBILE ── */
  @media (max-width: 768px) {
    .about-hero { padding: 56px 24px 48px; }
    .about-hero h1 { font-size: 52px; }
    .hero-sub { font-size: 15px; }

    .bio-opening {
      grid-template-columns: 1fr;
      min-height: auto;
    }

    .bio-opening-photo {
      border-right: none;
      border-bottom: 0.5px solid var(--tb-border);
      height: 280px;
    }

    .bio-opening-text { padding: 36px 24px; }
    .bio-pull { font-size: 24px; }

    .bio-continued { padding: 48px 24px; }
    .bio-final { padding: 48px 24px; }

    .pull-quote-section { padding: 48px 24px; }
    .pq-layout { grid-template-columns: 1fr; gap: 28px; }
    .pq-text { font-size: 24px; }
    .pq-photo img { height: 220px; }

    .speaking-strip { height: 320px; }

    .podcasts { padding: 48px 24px; }
    .podcasts-header { grid-template-columns: 1fr; gap: 24px; }
    .podcasts-header-photo { order: -1; }
    .podcasts-header-photo img { height: 220px; }
    .podcasts h2 { font-size: 32px; }
    .podcast-grid { grid-template-columns: 1fr 1fr; }

    .about-cta { padding: 56px 24px; }
    .about-cta h2 { font-size: 38px; }
    .cta-btns { flex-direction: column; align-items: center; }
    .cta-btns a { width: 100%; text-align: center; }

    .site-footer {
      flex-direction: column;
      gap: 8px;
      text-align: center;
      padding: 24px;
    }
  }
</style>