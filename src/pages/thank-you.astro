---
import Layout from '../components/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Thank You — TradeBuilt" description="Thank you for joining the Georgia Construction Talent Pipeline Study.">
  <Nav />
  <section class="ty-section">
    <div class="blueprint"></div>
    <div class="ty-content">
      <div class="eyebrow">Georgia Construction Talent Pipeline Study</div>
      <h1>You're In.<br><em>Thank You.</em></h1>
      <p>Your information has been received. We'll be in touch with next steps for participating in the study.</p>
      <p>In the meantime, explore what TradeBuilt is building for Georgia's construction workforce.</p>
      <div class="ty-btns">
        <a href="/" class="btn-cream">Back to Home</a>
        <a href="/about" class="btn-outline-ty">Learn About TradeBuilt</a>
      </div>
    </div>
  </section>
  <Footer />
</Layout>

<style>
  .ty-section {
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 80px 40px;
    background: var(--tb-bg-deep);
    position: relative;
    overflow: hidden;
  }

  .blueprint {
    position: absolute; top: 0; left: 0; right: 0; bottom: 0;
    background-image:
      linear-gradient(rgba(232,227,213,0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(232,227,213,0.04) 1px, transparent 1px);
    background-size: 48px 48px;
    pointer-events: none;
  }

  .ty-content {
    position: relative;
    z-index: 2;
    max-width: 560px;
    margin: 0 auto;
  }

  .eyebrow {
    display: inline-flex;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--tb-text-dim);
    margin-bottom: 24px;
    border: 0.5px solid var(--tb-border);
    padding: 6px 14px;
  }

  .ty-section h1 {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 900;
    font-size: 72px;
    line-height: 0.93;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: var(--tb-text-cream);
    margin-bottom: 28px;
  }

  .ty-section h1 em {
    font-style: normal;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--tb-text-cream);
  }

  .ty-section p {
    font-size: 15px;
    line-height: 1.75;
    color: var(--tb-text-dim);
    margin-bottom: 16px;
  }

  .ty-btns {
    display: flex;
    gap: 12px;
    justify-content: center;
    margin-top: 32px;
    flex-wrap: wrap;
  }

  .btn-outline-ty {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    background: transparent;
    color: var(--tb-text-cream);
    border: 1px solid var(--tb-border-mid);
    padding: 14px 28px;
    text-decoration: none;
    display: inline-block;
    transition: border-color 0.2s;
  }

  .btn-outline-ty:hover { border-color: var(--tb-text-cream); }

  .site-footer {
    padding: 18px 40px;
    border-top: 0.5px solid var(--tb-border);
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: var(--tb-bg-deep);
  }

  .footer-logo {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 900;
    font-size: 14px;
    color: var(--tb-text-ghost);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .footer-logo span { color: var(--tb-text-dark); }
  .footer-copy { font-size: 10px; color: var(--tb-text-dark); letter-spacing: 0.06em; }
</style>