    <!-- Facebook: add here once the page URL is confirmed. -->
  </div>
</footer>

<style>
  .tb-footer {
    padding: 22px 40px;
    border-top: 0.5px solid var(--tb-border);
    background: var(--tb-bg-deep);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
  }
  .tb-footer-logo {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--tb-text-cream);
    font-size: 15px;
  }
  .tb-footer-logo span { color: var(--tb-text-faint); margin: 0 4px; }
  .tb-footer-copy {
    font-size: 12px;
    color: var(--tb-text-faint);
    margin-top: 4px;
  }
  .tb-footer-social { display: flex; gap: 16px; }
  .tb-footer-social a { color: var(--tb-text-dim); transition: color 0.2s; display: flex; }
  .tb-footer-social a:hover { color: var(--tb-text-cream); }
  @media (max-width: 640px) {
    .tb-footer { flex-direction: column; align-items: flex-start; text-align: left; }
  }
</style>
