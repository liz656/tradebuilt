---
export interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'TradeBuilt — Georgia Construction Talent Pipeline Initiative',
  description = 'Amplifying real stories from the field. Attracting genuine talent.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;600;700;900&family=Barlow:wght@400;500;600&display=swap" rel="stylesheet">
<style is:global>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }
  body {
    font-family: 'Barlow', sans-serif;
    background: #141b28;
    color: #e8e3d5;
    -webkit-font-smoothing: antialiased;
  }
  :root {
    --tb-bg-deep: #0e1520;
    --tb-bg-base: #141b28;
    --tb-border: #1e2a3e;
    --tb-border-mid: #2d3f5f;
    --tb-border-dim: #1a2235;
    --tb-text-cream: #e8e3d5;
    --tb-text-muted: #9aa4b4;
    --tb-text-dim: #7a8a9e;
    --tb-text-faint: #5a6880;
    --tb-text-ghost: #3a4d66;
    --tb-text-dark: #2d3f5f;
  }
  .section-label {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--tb-text-ghost);
    margin-bottom: 32px;
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .section-label::after {
    content: '';
    flex: 1;
    height: 0.5px;
    background: var(--tb-border);
  }
  .btn-cream {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    background: #e8e3d5;
    color: #141b28;
    border: none;
    padding: 14px 32px;
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
    text-decoration: none;
    display: inline-block;
  }
  .btn-cream:hover { background: #9aa4b4; color: #0e1520; }
  .btn-primary {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    background: #e8e3d5;
    color: #141b28;
    border: none;
    padding: 14px 28px;
    cursor: pointer;
    transition: background 0.2s;
    text-decoration: none;
    display: inline-block;
  }
  .btn-primary:hover { background: #c8c4b8; }
  .btn-outline {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    background: transparent;
    color: #e8e3d5;
    border: 1px solid #2d3f5f;
    padding: 14px 28px;
    cursor: pointer;
    text-decoration: none;
    display: inline-block;
  }
</style>  
  </head>
  <body>
    <slot />
  </body>
</html>