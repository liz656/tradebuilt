---

<nav class="tb-nav">
  <a href="/" class="tb-logo-wrap">
    <img 
      src="/TradeBuilt Logo_NavyBckgdCreamLogo.png" 
      alt="TradeBuilt" 
      height="50"
      style="display:block;"
    />
  </a>

  <button class="hamburger" id="hamburger" aria-label="Toggle menu">
    <span></span>
    <span></span>
    <span></span>
  </button>

  <ul class="tb-nav-links" id="nav-links">
    <li><a href="/study">The Study</a></li>
    <li><a href="/careers">Find Your Trade</a></li>
    <li><a href="/find-training">Find Training</a></li>
    <li><a href="/about">About</a></li>
  </ul>
</nav>

<style>
  .tb-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 40px;
    border-bottom: 0.5px solid var(--tb-border);
    background: var(--tb-bg-deep);
    position: relative;
    z-index: 100;
  }

  a.tb-logo-wrap {
    text-decoration: none;
    display: flex;
    align-items: center;
  }

  .tb-nav-links {
    display: flex;
    gap: 28px;
    list-style: none;
  }

  .tb-nav-links li a {
    font-size: 15px;
    font-weight: 500;
    color: var(--tb-text-dim);
    text-decoration: none;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: color 0.2s;
  }

  .tb-nav-links li a:hover {
    color: var(--tb-text-cream);
  }

  /* ── HAMBURGER ── */
  .hamburger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
    z-index: 101;
  }

  .hamburger span {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--tb-text-cream);
    transition: all 0.3s ease;
  }

  .hamburger.open span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .hamburger.open span:nth-child(2) {
    opacity: 0;
  }

  .hamburger.open span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* ── MOBILE ── */
  @media (max-width: 768px) {
    .tb-nav {
      padding: 16px 24px;
      flex-wrap: wrap;
    }

    .hamburger {
      display: flex;
    }

    .tb-nav-links {
      display: none;
      flex-direction: column;
      gap: 0;
      width: 100%;
      background: var(--tb-bg-deep);
      border-top: 0.5px solid var(--tb-border);
      margin-top: 16px;
    }

    .tb-nav-links.open {
      display: flex;
    }

    .tb-nav-links li {
      border-bottom: 0.5px solid var(--tb-border);
    }

    .tb-nav-links li:last-child {
      border-bottom: none;
    }

    .tb-nav-links li a {
      display: block;
      padding: 16px 0;
      font-size: 16px;
    }
  }
</style>

<script>
  const hamburger = document.getElementById('hamburger');
  const navLinks = document.getElementById('nav-links');

  hamburger?.addEventListener('click', () => {
    hamburger.classList.toggle('open');
    navLinks?.classList.toggle('open');
  });

  // Close menu when a link is clicked
  navLinks?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      hamburger?.classList.remove('open');
      navLinks?.classList.remove('open');
    });
  });
</script>