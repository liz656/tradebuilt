---
// Report-notification signup for the Georgia Construction Talent Study.
// Delivery: Netlify Forms, form name "report-updates" (separate from the
// closed participant forms, so participant records are never mixed in).
// Use once per page — the element IDs are fixed.
import { CONTACT_EMAIL } from '../data/site.js';
---

<form
  name="report-updates"
  method="POST"
  data-netlify="true"
  netlify-honeypot="bot-field"
  action="/study/thanks-report-updates"
  class="rs-form"
  id="report-updates-form"
  novalidate
>
  <input type="hidden" name="form-name" value="report-updates" />
  <p class="rs-hidden" aria-hidden="true"><label>Don’t fill this out: <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>

  <div class="rs-field">
    <label for="rs-email">Email address</label>
    <input type="email" id="rs-email" name="email" required autocomplete="email" placeholder="you@example.com" aria-describedby="rs-consent rs-status" />
  </div>

  <p class="rs-consent" id="rs-consent">
    We’ll use this address to email you about the Georgia Construction Talent Study report. To be removed, email <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.
  </p>

  <button type="submit" class="rs-submit">Notify Me When the Report Is Available</button>

  <p class="rs-status" id="rs-status" role="status" aria-live="polite"></p>
</form>

<style>
  .rs-form {
    background: var(--tb-bg-base);
    border: 0.5px solid var(--tb-border);
    padding: 36px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .rs-hidden { display: none; }
  .rs-field { display: flex; flex-direction: column; gap: 8px; }
  .rs-field label {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--tb-text-muted);
  }
  .rs-field input {
    background: var(--tb-bg-deep);
    border: 0.5px solid var(--tb-border-mid);
    color: var(--tb-text-cream);
    padding: 13px 16px;
    font-family: 'Barlow', sans-serif;
    font-size: 15px;
    width: 100%;
  }
  .rs-field input::placeholder { color: var(--tb-text-ghost); }
  .rs-field input:focus { outline: 2px solid #c17830; outline-offset: 1px; border-color: var(--tb-text-cream); }
  .rs-field input[aria-invalid='true'] { border-color: #e0864a; }
  .rs-consent { font-size: 13px; line-height: 1.6; color: var(--tb-text-dim); }
  .rs-consent a { color: var(--tb-text-cream); }
  .rs-submit {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    background: var(--tb-text-cream);
    color: var(--tb-bg-base);
    border: none;
    padding: 16px 24px;
    cursor: pointer;
    transition: background 0.2s;
  }
  .rs-submit:hover { background: #c8c4b8; }
  .rs-submit:focus-visible { outline: 2px solid #c17830; outline-offset: 3px; }
  .rs-submit[disabled] { opacity: 0.6; cursor: wait; }
  .rs-status { font-size: 14px; line-height: 1.5; min-height: 1.5em; color: var(--tb-text-cream); }
  .rs-status.err { color: #f0a070; }
  @media (max-width: 640px) { .rs-form { padding: 26px 20px; } }
</style>

<script>
  const form = document.getElementById('report-updates-form') as HTMLFormElement | null;
  if (form) {
    const email = form.querySelector('#rs-email') as HTMLInputElement;
    const status = form.querySelector('#rs-status') as HTMLElement;
    const btn = form.querySelector('.rs-submit') as HTMLButtonElement;
    const say = (msg: string, err = false) => { status.textContent = msg; status.classList.toggle('err', err); };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (btn.disabled) return; // guard against double-submit
      if (!email.value.trim() || !email.checkValidity()) {
        email.setAttribute('aria-invalid', 'true');
        say('Please enter a valid email address.', true);
        email.focus();
        return;
      }
      email.removeAttribute('aria-invalid');
      btn.disabled = true;
      say('Sending…');
      try {
        const body = new URLSearchParams(new FormData(form) as any).toString();
        const res = await fetch('/', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        say('You’re signed up for report updates.');
        (window as any).gtag?.('event', 'report_updates_signup');
      } catch (err) {
        say('We couldn’t complete your signup. Please try again.', true);
      } finally {
        btn.disabled = false;
      }
    });
  }
</script>
